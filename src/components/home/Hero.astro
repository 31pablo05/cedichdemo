---
import { getWhatsappLink, whatsappMensajes } from '../../data/site.js';
import { fuentesResponsive } from '../../lib/imagenes.js';

const whatsappTurno = getWhatsappLink(whatsappMensajes.solicitarTurno);

const fuentesMobile = fuentesResponsive('hero-mobile', [480, 720, 941]);
const fuentesDesktop = fuentesResponsive('hero-desktop', [960, 1280, 1672]);
---

<section id="inicio" class="hero relative w-full overflow-hidden">
  <!-- =====================================================
       IMAGEN RESPONSIVE DE FONDO
       Mobile: public/imagenes/optimizadas/hero-mobile-*
       Desktop: public/imagenes/optimizadas/hero-desktop-*
       Versiones AVIF/WebP en varios anchos.
       sizes: con object-cover la imagen se recorta por alto, por eso
       en mobile y tablet necesita más ancho que el viewport.
  ====================================================== -->
  <picture class="hero-picture absolute inset-0 block h-full w-full">
    <source
      media="(min-width: 768px)"
      type="image/avif"
      srcset={fuentesDesktop.avif}
      sizes="(min-width: 1280px) 100vw, 1250px"
    />
    <source
      media="(min-width: 768px)"
      type="image/webp"
      srcset={fuentesDesktop.webp}
      sizes="(min-width: 1280px) 100vw, 1250px"
    />
    <source type="image/avif" srcset={fuentesMobile.avif} sizes="520px" />
    <source type="image/webp" srcset={fuentesMobile.webp} sizes="520px" />

    <img
      src={fuentesMobile.fallback}
      alt=""
      width="1080"
      height="1920"
      loading="eager"
      fetchpriority="high"
      class="hero-background absolute inset-0 h-full w-full object-cover"
    />
  </picture>

  <!-- =====================================================
       OVERLAY DESKTOP
       Oscuro a la izquierda para el contenido.
       La imagen queda más visible hacia la derecha.
  ====================================================== -->
  <div class="hero-overlay-desktop absolute inset-0 hidden md:block"></div>

  <!-- =====================================================
       OVERLAY MOBILE
       Mantiene la imagen visible pero permite leer.
  ====================================================== -->
  <div class="hero-overlay-mobile absolute inset-0 md:hidden"></div>

  <!-- Tinte general -->
  <div
    class="absolute inset-0 bg-[var(--color-navy)] opacity-[0.10] mix-blend-multiply lg:hidden"
  ></div>

  <!-- Resplandor de profundidad, esquina opuesta al texto -->
  <div class="hero-glow pointer-events-none absolute inset-0 hidden md:block"></div>

  <!-- =====================================================
       CONTENIDO
  ====================================================== -->
  <div
    class="container relative z-10 flex min-h-[760px] items-center pt-[118px] pb-12
           md:min-h-[650px] md:pt-[135px] md:pb-14
           lg:min-h-[680px] lg:pt-[124px] lg:pb-24
           xl:min-h-[720px]
           min-[1536px]:min-h-[740px]"
  >
    <div
      class="w-full text-left
             md:max-w-[610px]
             lg:max-w-[600px]
             xl:max-w-[660px]"
    >
      <!-- Ubicación -->
      <p
        class="hero-eyebrow eyebrow eyebrow-light reveal reveal-delay-0
               text-[12px] tracking-[0.18em]
               md:text-[13px]"
      >
        RAWSON, CHUBUT
      </p>

      <!-- H1 -->
      <h1
        class="hero-title mt-4 max-w-[15ch] text-white
               text-[42px] leading-[0.99] tracking-[-0.035em]
               sm:text-[48px]
               md:text-[56px]
               lg:max-w-none
               reveal reveal-delay-1"
      >
        Centro de Endoscopías Digestivas de Chubut
      </h1>

      <!-- Bajada -->
      <p
        class="hero-lead mt-6 max-w-[54ch]
               text-[16px] leading-[1.7] text-white/78
               md:text-[17px]
               lg:text-[18px]
               reveal reveal-delay-2"
      >
        Diagnóstico preciso, tecnología de última generación y un
        equipo comprometido con tu bienestar. Coordinamos tu turno
        por WhatsApp, sin llamadas ni esperas.
      </p>

      <!-- ===================================================
           CTAs
      ==================================================== -->
      <div
        class="mt-8 flex flex-col gap-3
               sm:flex-row sm:gap-4
               lg:mt-9
               reveal reveal-delay-3"
      >
        <!-- Principal -->
        <a
          href={whatsappTurno}
          target="_blank"
          rel="noopener noreferrer"
          class="hero-cta hero-cta-primary group inline-flex min-h-[54px] w-full items-center
                 justify-center gap-2.5 rounded-[var(--radius-pill)]
                 px-7 py-3.5 text-[15px] font-semibold text-white
                 shadow-[var(--shadow-card)]
                 transition duration-300
                 hover:-translate-y-[2px]
                 hover:brightness-110
                 hover:shadow-[var(--shadow-card-hover)]
                 sm:w-auto"
        >
          <svg
            class="h-[19px] w-[19px]"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
          >
            <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38a9.9 9.9 0 0 0 4.74 1.21h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.86 9.86 0 0 0 12.04 2Zm0 1.67c2.19 0 4.25.85 5.8 2.4a8.18 8.18 0 0 1 2.41 5.84c0 4.55-3.7 8.24-8.24 8.24a8.3 8.3 0 0 1-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.55 3.7-8.24 8.28-8.24Zm-4.53 4.7c-.16 0-.42.06-.64.3-.22.24-.85.83-.85 2.02 0 1.19.87 2.34 1 2.5.12.16 1.7 2.6 4.13 3.64 2.04.87 2.46.7 2.9.65.44-.04 1.42-.58 1.62-1.14.2-.56.2-1.04.14-1.14-.06-.1-.22-.16-.46-.28-.24-.12-1.42-.7-1.64-.78-.22-.08-.38-.12-.54.12-.16.24-.62.78-.76.94-.14.16-.28.18-.52.06-.24-.12-1.02-.38-1.94-1.2-.72-.64-1.2-1.44-1.34-1.68-.14-.24-.02-.37.1-.5.11-.1.24-.28.36-.42.12-.14.16-.24.24-.4.08-.16.04-.3-.02-.42-.06-.12-.54-1.32-.75-1.8-.2-.47-.4-.4-.55-.4h-.48Z" />
          </svg>

          Pedir turno por WhatsApp
        </a>

        <!-- Secundario -->
        <a
          href="#pacientes"
          class="hero-cta hero-cta-secondary inline-flex min-h-[54px] w-full items-center
                 justify-center rounded-[var(--radius-pill)]
                 border border-white/30
                 bg-[rgba(5,27,57,0.30)]
                 px-7 py-3.5 text-[15px] font-semibold text-white
                 backdrop-blur-[6px]
                 transition duration-300
                 hover:-translate-y-[2px]
                 hover:border-[var(--color-cyan)]
                 hover:bg-white/[0.08]
                 sm:w-auto"
        >
          Cómo pedir turno
        </a>
      </div>

      <!-- ===================================================
           BENEFICIOS
      ==================================================== -->
      <div
        class="mt-10 border-t border-white/[0.13] pt-6
               md:mt-12 md:pt-7
               reveal reveal-delay-4"
      >
        <div
          class="hero-benefits grid grid-cols-1 gap-4
                 min-[390px]:grid-cols-3
                 md:max-w-[690px] md:grid-cols-3 md:gap-0
                 lg:flex lg:max-w-none"
        >
          <!-- Atención -->
          <div
            class="hero-benefit flex items-start gap-3
                   min-[390px]:flex-col min-[390px]:gap-2
                   md:flex-row md:gap-3 md:pr-6"
          >
            <svg
              class="hero-benefit-icon h-[21px] w-[21px] shrink-0 text-[var(--color-cyan)]"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              aria-hidden="true"
            >
              <circle cx="9" cy="8" r="3" />
              <path d="M3 20a6 6 0 0 1 12 0" />
              <circle cx="17" cy="9" r="2.5" />
              <path d="M15 20a5 5 0 0 1 6-4.9" />
            </svg>

            <p class="hero-benefit-text text-[12px] leading-[1.4] md:text-[13px]">
              <span class="block font-semibold text-white">
                Atención cálida
              </span>
              <span class="mt-0.5 block text-white/60">
                y personalizada
              </span>
            </p>
          </div>

          <!-- Tecnología -->
          <div
            class="hero-benefit flex items-start gap-3
                   min-[390px]:flex-col min-[390px]:gap-2
                   md:border-l md:border-white/[0.12]
                   md:px-6
                   md:flex-row md:gap-3"
          >
            <svg
              class="hero-benefit-icon h-[21px] w-[21px] shrink-0 text-[var(--color-cyan)]"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              aria-hidden="true"
            >
              <rect x="3" y="4" width="18" height="12" rx="1.5" />
              <path d="M8 20h8" />
              <path d="M12 16v4" />
              <path d="M7 9l3 3 2-2 4 4" />
            </svg>

            <p class="hero-benefit-text text-[12px] leading-[1.4] md:text-[13px]">
              <span class="block font-semibold text-white">
                Tecnología
              </span>
              <span class="mt-0.5 block text-white/60">
                de última generación
              </span>
            </p>
          </div>

          <!-- Seguridad -->
          <div
            class="hero-benefit flex items-start gap-3
                   min-[390px]:flex-col min-[390px]:gap-2
                   md:border-l md:border-white/[0.12]
                   md:pl-6
                   md:flex-row md:gap-3"
          >
            <svg
              class="hero-benefit-icon h-[21px] w-[21px] shrink-0 text-[var(--color-cyan)]"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              aria-hidden="true"
            >
              <path d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6l7-3Z" />
              <path d="M9 12l2 2 4-4" />
            </svg>

            <p class="hero-benefit-text text-[12px] leading-[1.4] md:text-[13px]">
              <span class="block font-semibold text-white">
                Procedimientos
              </span>
              <span class="mt-0.5 block text-white/75">
                seguros y eficaces
              </span>
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>

  
</section>

<style>
  /*
   * El background ocupa siempre el hero completo.
   * Solo modificamos el punto de recorte según dispositivo.
   * Primer valor: horizontal (izq/der), segundo valor: vertical (arriba/abajo)
   * Vertical: valores menores muestran más arriba, valores mayores muestran más abajo
   */

  .hero-background {
    object-position: 48% 35%;
    animation: hero-image-enter 1200ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .hero-overlay-desktop {
    background: linear-gradient(90deg, rgba(3, 18, 40, 0.98) 0%, rgba(3, 18, 40, 0.95) 24%, rgba(3, 18, 40, 0.84) 38%, rgba(3, 18, 40, 0.55) 52%, rgba(3, 18, 40, 0.18) 72%, rgba(3, 18, 40, 0.08) 100%);
  }

  .hero-overlay-mobile {
    background: linear-gradient(180deg, rgba(3, 18, 40, 0.92) 0%, rgba(3, 18, 40, 0.82) 32%, rgba(3, 18, 40, 0.80) 65%, rgba(3, 18, 40, 0.95) 100%);
  }

  .hero-glow {
    background-image: radial-gradient(55% 50% at 88% 12%, rgba(11, 172, 219, 0.18) 0%, transparent 70%);
  }

  .hero-cta-primary {
    background-image: var(--gradient-blue);
  }

  /* Ken Burns continuo y muy sutil, independiente de la entrada de la imagen */
  .hero-picture {
    animation: hero-ken-burns 22s ease-in-out infinite alternate;
    transform-origin: center;
    will-change: transform;
  }

  @keyframes hero-ken-burns {
    from {
      transform: scale(1);
    }

    to {
      transform: scale(1.045);
    }
  }

  .hero-scroll-arrow {
    animation: hero-bounce 1.8s ease-in-out infinite;
  }

  @keyframes hero-bounce {
    0%,
    100% {
      transform: translateY(0);
      opacity: 0.55;
    }

    50% {
      transform: translateY(5px);
      opacity: 1;
    }
  }

  @media (min-width: 768px) {
    .hero-background {
      /*
       * Si necesitás mover el médico/logo:
       *
       * Horizontal (primer valor):
       * más a la derecha -> 60%, 65%, 70%
       * más a la izquierda -> 45%, 40%
       *
       * Vertical (segundo valor):
       * más arriba -> 30%, 25%
       * más abajo -> 45%, 50%
       */
      object-position: 62% 35%;
    }
  }

  @media (min-width: 1280px) {
    .hero-background {
      object-position: center 35%;
    }
  }

  @keyframes hero-image-enter {
    from {
      transform: scale(1.035);
      opacity: 0.7;
    }

    to {
      transform: scale(1);
      opacity: 1;
    }
  }

  /* =====================================================
     DESKTOP (1024 px o más)
     Los selectores de clase del componente se imponen a las reglas
     globales de h1 y p, que de otro modo fijan tamaño e interlínea.
  ====================================================== */
  @media (min-width: 1024px) {
    /* La foto se corre a la derecha para que el logo de la pared quede libre de texto; el borde se funde con el petróleo */
    .hero {
      background-color: var(--color-navy-deep);
    }

    .hero-picture {
      left: 20%;
      width: 80%;
      transform-origin: right center;
      mask-image: linear-gradient(90deg, transparent 0%, #000 22%);
    }

    .hero-background {
      object-position: 30% 35%;
    }

    .hero-overlay-desktop {
      background:
        radial-gradient(
          ellipse 62% 48% at 18% 100%,
          color-mix(in srgb, var(--color-navy-deep) 88%, transparent) 0%,
          color-mix(in srgb, var(--color-navy-deep) 68%, transparent) 55%,
          transparent 100%
        ),
        linear-gradient(
          90deg,
          color-mix(in srgb, var(--color-navy-deep) 95%, transparent) 0%,
          color-mix(in srgb, var(--color-navy-deep) 90%, transparent) 32%,
          color-mix(in srgb, var(--color-navy) 62%, transparent) 48%,
          color-mix(in srgb, var(--color-navy) 20%, transparent) 60%,
          transparent 72%
        ),
        linear-gradient(
          0deg,
          color-mix(in srgb, var(--color-navy-deep) 40%, transparent) 0%,
          transparent 20%
        );
    }

    .hero-glow {
      background-image: radial-gradient(
        50% 55% at 86% 8%,
        color-mix(in srgb, var(--color-cyan) 20%, transparent) 0%,
        transparent 70%
      );
    }

    .hero-picture {
      animation-duration: 32s;
    }

    @keyframes hero-ken-burns {
      from {
        transform: scale(1);
      }

      to {
        transform: scale(1.03);
      }
    }

    .hero-eyebrow {
      display: flex;
      align-items: center;
      gap: 12px;
      font-family: var(--font-text);
      font-size: 13px;
      color: var(--color-cyan-light);
    }

    .hero-eyebrow::before {
      content: '';
      width: 32px;
      height: 2px;
      border-radius: var(--radius-pill);
      background-color: var(--color-cyan);
    }

    .hero-title {
      font-family: var(--font-title);
      font-weight: 700;
      font-size: clamp(46px, calc(2.885vw + 16.5px), 58px);
      line-height: 1.1;
      letter-spacing: -0.03em;
      /* ~11em deja entrar "Digestivas de Chubut" y no "Centro de Endoscopías": tres líneas sin saltos forzados */
      max-width: 11.1em;
      text-wrap: balance;
    }

    .hero-lead {
      font-family: var(--font-text);
      font-size: 18px;
      line-height: 1.65;
      max-width: 29em;
      margin-top: 20px;
      color: color-mix(in srgb, var(--color-white) 86%, transparent);
    }

    .hero-cta {
      min-height: 56px;
      padding: 0 28px;
      border: 1.5px solid transparent;
      font-family: var(--font-text);
      font-size: 16px;
      font-weight: 700;
      line-height: 1;
      white-space: nowrap;
      transition: background-color 250ms ease, border-color 250ms ease, color 250ms ease,
        box-shadow 250ms ease, translate 250ms ease;
    }

    .hero-cta-primary {
      background-color: var(--color-cyan);
      background-image: none;
      color: var(--color-navy-deep);
      box-shadow: 0 8px 24px color-mix(in srgb, var(--color-cyan) 28%, transparent);
    }

    .hero-cta-primary:hover {
      background-color: var(--color-cyan-light);
      filter: none;
      box-shadow: 0 10px 28px color-mix(in srgb, var(--color-cyan) 38%, transparent);
    }

    .hero-cta-secondary {
      border-color: color-mix(in srgb, var(--color-white) 55%, transparent);
      background-color: color-mix(in srgb, var(--color-navy-deep) 40%, transparent);
      color: var(--color-white);
    }

    .hero-cta-secondary:hover {
      border-color: var(--color-white);
      background-color: color-mix(in srgb, var(--color-white) 14%, transparent);
    }

    .hero-cta:focus-visible {
      outline-color: var(--color-white);
    }

    .hero-benefits {
      align-items: center;
      max-width: 720px;
    }

    .hero-benefit {
      flex: none;
      align-items: center;
      gap: 14px;
    }

    .hero-benefit + .hero-benefit {
      margin-left: 24px;
      padding-left: 24px;
      border-color: color-mix(in srgb, var(--color-white) 16%, transparent);
    }

    .hero-benefit:first-child {
      padding-right: 0;
    }

    .hero-benefit-icon {
      box-sizing: content-box;
      width: 22px;
      height: 22px;
      padding: 9px;
      border: 1px solid color-mix(in srgb, var(--color-cyan) 38%, transparent);
      border-radius: var(--radius-pill);
      background-color: color-mix(in srgb, var(--color-navy-deep) 55%, transparent);
      color: var(--color-cyan-light);
    }

    .hero-benefit-text {
      max-width: none;
      font-family: var(--font-text);
      font-size: 14px;
      line-height: 1.4;
      white-space: nowrap;
    }

    .hero-benefit-text > span:first-child {
      font-size: 15px;
      font-weight: 600;
    }

    .hero-benefit-text > span + span {
      margin-top: 2px;
      color: color-mix(in srgb, var(--color-white) 72%, transparent);
    }

    .hero-scroll-cue {
      bottom: 20px;
      font-family: var(--font-text);
    }

    .hero-scroll-cue > span {
      color: color-mix(in srgb, var(--color-white) 70%, transparent);
    }
  }

  /* Entrada del hero: más pausada y con desaceleración suave */
  @media (min-width: 1280px) {
    .hero-lead {
      max-width: 32em;
    }
  }
  @media (min-width: 1024px) {
    .hero .reveal {
      transform: translateY(18px);
      transition-duration: 800ms;
      transition-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
    }

    .hero .reveal.is-visible {
      transform: translateY(0);
    }

    .hero .reveal-delay-1 { transition-delay: 100ms; }
    .hero .reveal-delay-2 { transition-delay: 200ms; }
    .hero .reveal-delay-3 { transition-delay: 300ms; }
    .hero .reveal-delay-4 { transition-delay: 400ms; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-background,
    .hero-picture,
    .hero-scroll-arrow {
      animation: none;
    }

    .hero .reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }

    .hero-cta,
    .hero-cta:hover {
      translate: none;
      transition: none;
    }
  }
</style>