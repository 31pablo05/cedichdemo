---
import { site, getWhatsappLink } from '../../data/site.js';
import HexPattern from '../ui/HexPattern.astro';

const whatsappLink = getWhatsappLink('Hola, quiero coordinar un turno');
const mapaSrc = `https://www.google.com/maps?q=${encodeURIComponent(
  `${site.direccion}, ${site.localidad}`
)}&output=embed`;
---

<section
  id="contacto"
  class="relative w-full py-14 md:py-22 overflow-hidden"
  style={{ backgroundImage: 'var(--gradient-navy)' }}
>
  <HexPattern color="var(--color-cyan)" opacity={0.06} />

  <div class="container relative">
    <div class="grid grid-cols-1 lg:grid-cols-[32%_38%_30%] gap-8 lg:gap-6">
      <!-- Columna de datos -->
      <div>
        <p class="eyebrow eyebrow-light">UBICACIÓN Y CONTACTO</p>
        <h2 class="mt-4 text-white">Estamos cerca, para lo que necesites</h2>

        <div class="mt-6 flex flex-col gap-[18px]">
          <div class="flex items-start gap-3">
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="var(--color-cyan)"
              stroke-width="1.5"
              class="shrink-0 mt-0.5"
              aria-hidden="true"
            >
              <path d="M12 21s7-6.5 7-11.5A7 7 0 0 0 5 9.5C5 14.5 12 21 12 21Z" />
              <circle cx="12" cy="9.5" r="2.5" />
            </svg>
            <p class="text-[15px] font-semibold text-white max-w-none">
              {site.direccion}
              <span class="block mt-1 text-[13px] font-normal text-white/65">
                {site.localidad} · {site.referencia}
              </span>
            </p>
          </div>

          <div class="flex items-start gap-3">
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="var(--color-cyan)"
              stroke-width="1.5"
              class="shrink-0 mt-0.5"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="9" />
              <path d="M12 7v5l3 3" />
            </svg>
            <p class="text-[15px] font-semibold text-white max-w-none">
              Horarios
              {
                site.horarios.map((horario) => (
                  <span class="block mt-1 text-[13px] font-normal text-white/65">
                    {horario.dia} de {horario.franja}
                  </span>
                ))
              }
            </p>
          </div>

          <div class="flex items-start gap-3">
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="var(--color-cyan)"
              stroke-width="1.5"
              class="shrink-0 mt-0.5"
              aria-hidden="true"
            >
              <path d="M6 3h3l2 5-2.5 1.5a11 11 0 0 0 5 5L15 12l5 2v3a2 2 0 0 1-2 2A16 16 0 0 1 4 5a2 2 0 0 1 2-2Z" />
            </svg>
            <a href={`tel:+${site.whatsapp}`} class="text-[15px] font-semibold text-white max-w-none">
              {site.telefono}
            </a>
          </div>

          <div class="flex items-start gap-3">
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="var(--color-cyan)"
              stroke-width="1.5"
              class="shrink-0 mt-0.5"
              aria-hidden="true"
            >
              <rect x="3" y="3" width="18" height="18" rx="5" />
              <circle cx="12" cy="12" r="4" />
              <circle cx="17.5" cy="6.5" r="1" fill="var(--color-cyan)" stroke="none" />
            </svg>
            <a
              href={site.instagram.url}
              target="_blank"
              rel="noopener noreferrer"
              class="text-[15px] font-semibold text-white max-w-none"
            >
              {site.instagram.usuario}
            </a>
          </div>
        </div>
      </div>

      <!-- Columna del mapa -->
      <div>
        <iframe
          src={mapaSrc}
          title={`Ubicación de ${site.nombreCorto} en ${site.direccion}, ${site.localidad}`}
          loading="lazy"
          class="w-full h-[240px] lg:h-full rounded-[var(--radius)] border border-white/[0.12]"
        ></iframe>

        <a
          href={site.googleMapsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-4 inline-flex items-center justify-center w-full lg:w-auto rounded-[var(--radius-pill)] border-[1.5px] border-white/35 text-white px-6 py-3 font-medium transition-colors hover:border-[var(--color-cyan)]"
        >
          Cómo llegar
        </a>
      </div>

      <!-- Columna de la card de WhatsApp -->
      <div>
        <div
          class="rounded-[var(--radius)] p-7"
          style={{ backgroundImage: 'var(--gradient-blue)' }}
        >
          <svg width="34" height="34" viewBox="0 0 24 24" fill="white" aria-hidden="true">
            <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38a9.9 9.9 0 0 0 4.74 1.21h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.86 9.86 0 0 0 12.04 2Zm0 1.67c2.19 0 4.25.85 5.8 2.4a8.18 8.18 0 0 1 2.41 5.84c0 4.55-3.7 8.24-8.24 8.24a8.3 8.3 0 0 1-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.55 3.7-8.24 8.28-8.24Zm-4.53 4.7c-.16 0-.42.06-.64.3-.22.24-.85.83-.85 2.02 0 1.19.87 2.34 1 2.5.12.16 1.7 2.6 4.13 3.64 2.04.87 2.46.7 2.9.65.44-.04 1.42-.58 1.62-1.14.2-.56.2-1.04.14-1.14-.06-.1-.22-.16-.46-.28-.24-.12-1.42-.7-1.64-.78-.22-.08-.38-.12-.54.12-.16.24-.62.78-.76.94-.14.16-.28.18-.52.06-.24-.12-1.02-.38-1.94-1.2-.72-.64-1.2-1.44-1.34-1.68-.14-.24-.02-.37.1-.5.11-.1.24-.28.36-.42.12-.14.16-.24.24-.4.08-.16.04-.3-.02-.42-.06-.12-.54-1.32-.75-1.8-.2-.47-.4-.4-.55-.4h-.48Z" />
          </svg>

          <h3 class="mt-4 text-[19px] font-bold text-white">Consultanos por WhatsApp</h3>
          <p class="mt-2.5 text-[14px] text-white/85 max-w-none">
            Respondemos tus dudas y te ayudamos a coordinar tu turno.
          </p>

          <a
            href={whatsappLink}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-[22px] inline-flex items-center justify-center w-full rounded-[var(--radius-pill)] bg-white text-[var(--color-blue-dark)] px-6 py-3 font-semibold"
          >
            Escribir por WhatsApp
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
