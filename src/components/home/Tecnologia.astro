---
import { tecnologia } from '../../data/tecnologia.js';
import HexPattern from '../ui/HexPattern.astro';

/** @type {Record<string, string>} */
const iconosPaths = {
  lupa: '<circle cx="10" cy="10" r="6" /><path d="M20 20l-5.5-5.5" />',
  monitor: '<rect x="3" y="4" width="18" height="12" rx="1.5" /><path d="M8 20h8" /><path d="M12 16v4" />',
  escudo: '<path d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6l7-3Z" /><path d="M9 12l2 2 4-4" />',
};
---

<section
  id="tecnologia"
  class="container my-14 md:my-24"
>
  <div
    class="relative rounded-[var(--radius-lg)] overflow-hidden"
    style={{ backgroundImage: 'var(--gradient-navy)' }}
  >
    <HexPattern color="var(--color-cyan)" opacity={0.06} />

    <div class="relative flex flex-col-reverse lg:flex-row">
      <!-- Zona izquierda: texto -->
      <div class="lg:w-[52%] p-6 md:p-12">
        <p class="eyebrow eyebrow-light">TECNOLOGÍA Y EQUIPAMIENTO</p>
        <h2 class="mt-4 text-white">Diagnóstico preciso con equipamiento propio</h2>
        <p class="mt-4 text-white/75 text-[15px] max-w-[50ch]">
          Contamos con endoscopios propios y mantenimiento periódico. Eso significa estudios más
          rápidos, más seguros y con mejor calidad de imagen para vos.
        </p>

        <div class="mt-8 flex flex-row gap-6 md:gap-8 text-center lg:text-left">
          {
            tecnologia.map((item) => (
              <div class="flex-1 flex flex-col items-center lg:items-start">
                <div class="w-12 h-12 rounded-full border border-[var(--color-cyan)]/40 bg-white/[0.06] flex items-center justify-center">
                  <svg
                    width="22"
                    height="22"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="white"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                    set:html={iconosPaths[item.icono]}
                  />
                </div>
                <p class="mt-3 text-[13px] font-semibold text-white max-w-[140px]">{item.titulo}</p>
                <p class="mt-1 text-[12px] text-white/60 max-w-[140px]">{item.descripcion}</p>
              </div>
            ))
          }
        </div>

        <a
          href="#servicios"
          class="mt-8 inline-flex items-center justify-center rounded-[var(--radius-pill)] bg-white text-[var(--color-ink)] px-6 py-3 font-medium"
        >
          Ver estudios que realizamos
        </a>
      </div>

      <!-- Zona derecha: foto -->
      <div class="relative lg:w-[48%] aspect-video lg:aspect-auto">
        <!-- Respaldo mientras no exista la foto: PENDIENTE CLIENTE, foto del endoscopio o sala de estudios -->
        <div
          class="absolute inset-0 flex items-center justify-center"
          style={{ backgroundImage: 'var(--gradient-navy)' }}
        >
          <HexPattern color="var(--color-cyan)" opacity={0.06} />
          <img
            src="/logos/logo-cedich.png"
            alt=""
            width="160"
            height="160"
            class="relative w-28 h-28 md:w-40 md:h-40 opacity-10"
          />
        </div>

        <img
          src="/imagenes/equipamiento.jpg"
          alt="Equipamiento de endoscopía de CEDICH"
          width="800"
          height="600"
          loading="lazy"
          class="absolute inset-0 w-full h-full object-cover"
        />

        <div
          class="absolute inset-y-0 left-0 w-1/2"
          style={{ backgroundImage: 'linear-gradient(to right, var(--color-navy), transparent)' }}
        />
        <div class="absolute inset-0 bg-[var(--color-navy)] opacity-20 mix-blend-multiply"></div>
      </div>
    </div>
  </div>
</section>
