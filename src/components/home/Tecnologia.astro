---
import { tecnologia } from '../../data/tecnologia.js';
import HexPattern from '../ui/HexPattern.astro';

/** @type {Record<string, string>} */
const iconosPaths = {
  lupa: '<circle cx="10" cy="10" r="6" /><path d="M20 20l-5.5-5.5" />',
  monitor: '<rect x="3" y="4" width="18" height="12" rx="1.5" /><path d="M8 20h8" /><path d="M12 16v4" />',
  escudo: '<path d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6l7-3Z" /><path d="M9 12l2 2 4-4" />',
};
---

<section
  id="tecnologia"
  class="container my-14 md:my-24"
>
  <div
    class="relative flex flex-col-reverse overflow-hidden rounded-[var(--radius-lg)] border border-white/[0.08] shadow-[var(--shadow-card-hover)] lg:block lg:min-h-[620px]"
    style={{ backgroundImage: 'var(--gradient-navy)' }}
  >
    <HexPattern color="var(--color-cyan)" opacity={0.06} />

    <!-- Zona izquierda: texto -->
    <div class="p-6 md:p-12 lg:relative lg:z-10 lg:w-[55%] lg:p-14">
        <p class="eyebrow eyebrow-light">TECNOLOGÍA Y EQUIPAMIENTO</p>
        <h2 class="mt-4 text-white">Diagnóstico preciso con equipamiento propio</h2>
        <p class="mt-4 text-white/75 text-[15px] max-w-[50ch]">
          Contamos con endoscopios propios y mantenimiento periódico. Eso significa estudios más
          rápidos, más seguros y con mejor calidad de imagen para vos.
        </p>

        <div class="mt-8 flex flex-col gap-5">
          {
            tecnologia.map((item) => (
              <div class="flex items-start gap-4">
                <div class="flex h-[46px] w-[46px] shrink-0 items-center justify-center rounded-[var(--radius)] border border-[var(--color-cyan)]/25 bg-white/[0.08]">
                  <svg
                    width="22"
                    height="22"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="var(--color-cyan)"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                    set:html={iconosPaths[item.icono]}
                  />
                </div>
                <div>
                  <p class="text-[15px] font-semibold text-white">{item.titulo}</p>
                  <p class="mt-1 text-[14px] text-white/65">{item.descripcion}</p>
                </div>
              </div>
            ))
          }
        </div>

        <a
          href="#servicios"
          class="group mt-8 inline-flex items-center justify-center gap-2 rounded-[var(--radius-pill)] bg-white text-[var(--color-ink)] px-6 py-3 font-medium"
        >
          Ver estudios que realizamos
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            class="transition-transform group-hover:translate-x-1"
            aria-hidden="true"
          >
            <path d="M5 12h14" />
            <path d="M13 6l6 6-6 6" />
          </svg>
        </a>
    </div>

    <!-- Zona derecha: foto. Panel en mobile, fondo completo de la tarjeta desde lg -->
    <div class="relative aspect-[16/10] lg:absolute lg:inset-0 lg:aspect-auto">
        <picture>
          <source media="(min-width: 1024px)" srcset="/imagenes/equipamiento-desktop.webp" />
          <img
            src="/imagenes/equipamiento-mobile.webp"
            alt="Sala de estudios y equipamiento de endoscopía de CEDICH"
            width="900"
            height="750"
            loading="lazy"
            class="absolute inset-0 h-full w-full object-cover object-center saturate-[.85] lg:object-[60%_50%]"
          />
        </picture>

        <div class="absolute inset-0 bg-[var(--color-navy)] opacity-25 mix-blend-multiply"></div>
        <div class="absolute inset-0 bg-[var(--color-navy)] opacity-10"></div>

        <div
          class="absolute inset-x-0 bottom-0 h-1/2 lg:hidden"
          style={{
            backgroundImage: 'linear-gradient(to bottom, transparent 0%, var(--color-navy) 100%)',
          }}
        />
        <div
          class="hidden lg:block lg:absolute lg:inset-0"
          style={{
            backgroundImage:
              'linear-gradient(to right, var(--color-navy) 0%, var(--color-navy) 45%, transparent 85%)',
          }}
        />
    </div>
  </div>
</section>
