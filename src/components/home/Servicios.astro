---
import { servicios } from '../../data/servicios.js';
import HexPattern from '../ui/HexPattern.astro';
import SectionHeading from '../ui/SectionHeading.astro';

/** @type {Record<string, string>} */
const iconosPaths = {
  estomago:
    '<path d="M10.8 1.6c-.8 0-1.4.6-1.4 1.4v2.5C6 6.5 3.4 9.7 3.4 13.5c0 4.4 3.6 8 8 8h.3c3 0 5.4-2.4 5.4-5.4 0-2.1-1.2-3.9-3-4.8-.4-.2-.7-.6-.7-1.1V8.8c0-.5.3-.9.8-1 1.4-.4 2.6-1.3 3.2-2.6.4-.8-.2-1.7-1.1-1.7-.5 0-.9.3-1.1.7-.3.6-.9 1-1.6 1h-1.4V3c0-.8-.6-1.4-1.4-1.4z" fill="currentColor" stroke="none"/><path d="M15.8 15.4c1.6 0 2.9 1.3 2.9 2.9v2.3" stroke-width="2.3" stroke-linecap="round"/>',
  colon:
    '<path d="M4.6 21.5v-11A5.4 5.4 0 0 1 10 5.1h4a5.4 5.4 0 0 1 5.4 5.4v5.1a4 4 0 0 1-4 4h-1.6a2.8 2.8 0 0 0-2.8 2.8" stroke-width="2.7" stroke-linecap="round" stroke-linejoin="round"/>',
  higado:
    '<path d="M2.8 4.6h12.4c2.7 0 4.8 2.2 4.8 4.8 0 3.3-2.3 6.1-5.5 6.7l-2.2.4c-.6.1-1.1-.1-1.4-.6l-.8-1.1-1.2 1c-.4.4-1 .4-1.5.1C4.6 14.3 2 10.6 2 6.4v-1c0-.5.3-.8.8-.8z" fill="currentColor" stroke="none"/><path d="M13.6 17.4c0 1.9 1.2 3.3 2.6 3.3s2.6-1.4 2.6-3.3c0-1.3-.6-2.4-1.5-2.9" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>',
  escudo:
    '<path d="M12 2.4 3.9 5.4v6.2c0 4.7 3.3 8.4 8.1 9.9 4.8-1.5 8.1-5.2 8.1-9.9V5.4L12 2.4z" stroke-width="2.2" stroke-linejoin="round"/><path d="M8.4 11.9l2.6 2.6 5.1-5.4" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round"/>',
};
---

<section id="servicios" class="relative bg-[var(--color-surface)] pt-14 pb-6 md:pt-24 md:pb-16 overflow-hidden">
  <!-- Franja de transición desde el hero oscuro -->
  <div class="pointer-events-none absolute inset-x-0 top-0 h-20" style={{ backgroundImage: 'linear-gradient(to bottom, white 0%, var(--color-surface) 100%)' }}></div>

  <!-- Resplandor radial azul muy tenue, arriba -->
  <div
    class="pointer-events-none absolute inset-x-0 top-0 h-[520px]"
    style={{
      backgroundImage:
        'radial-gradient(60% 60% at 50% 0%, color-mix(in srgb, var(--color-blue) 10%, transparent) 0%, transparent 100%)',
    }}
  ></div>

  <div class="servicios-hex-mask absolute inset-0 pointer-events-none">
    <HexPattern color="var(--color-blue)" opacity={0.05} />
  </div>

  <div class="container relative">
    <SectionHeading
      eyebrow="NUESTROS SERVICIOS"
      titulo="Cuatro áreas clave para tu salud digestiva"
      bajada="Estudios diagnósticos y terapéuticos con equipamiento de última generación."
      tema="claro"
      alineacion="centro"
    />

    <div
      class="servicios-scroll mt-[28px] md:mt-10 -mx-5 flex snap-x snap-mandatory gap-4 overflow-x-auto px-5 pb-2 sm:mx-0 sm:grid sm:grid-cols-2 sm:gap-6 sm:overflow-visible sm:px-0 sm:pb-0 sm:snap-none lg:grid-cols-4"
    >
      {
        servicios.map((servicio, index) => (
          <div
            class={`servicio-card group reveal reveal-delay-${Math.min(index, 4)} relative h-full w-[72vw] max-w-[260px] shrink-0 snap-start overflow-hidden flex flex-col bg-white border border-[var(--color-border)] rounded-[var(--radius)] shadow-[var(--shadow-card)] p-5 md:p-[26px] sm:w-auto sm:max-w-none sm:shrink`}
          >
            <span class="servicio-card-accent absolute inset-x-0 top-0 left-0 h-[3px] w-0" />

            <span
              class="servicio-card-index absolute top-3 right-4 font-display font-bold text-[34px] sm:text-[46px] leading-none select-none"
              aria-hidden="true"
            >
              {String(index + 1).padStart(2, '0')}
            </span>

            <div class="relative z-10 flex h-full flex-col">
              <div class="servicio-card-tile w-[54px] h-[54px] rounded-[var(--radius)] flex items-center justify-center">
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  class="servicio-card-icon w-6 h-6 sm:w-[26px] sm:h-[26px] text-white"
                  set:html={iconosPaths[servicio.icono]}
                />
              </div>

              <h3 class="servicio-card-title mt-5 text-[var(--color-ink)] max-w-[22ch] leading-[1.3] sm:min-h-[2.6em]">{servicio.titulo}</h3>

              <p class="servicio-card-desc mt-3 text-[14px] text-[var(--color-muted)] leading-[1.6] max-w-none flex-1">
                {servicio.descripcion}
              </p>

              <a
                href="#pacientes"
                class="servicio-card-link mt-auto pt-5 inline-flex items-center gap-1.5 text-[14px] font-semibold text-[var(--color-blue)]"
              >
                Ver preparación
                <svg
                  width="14"
                  height="14"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  class="transition-transform group-hover:translate-x-1 group-focus-within:translate-x-1"
                  aria-hidden="true"
                >
                  <path d="M5 12h14" />
                  <path d="M13 6l6 6-6 6" />
                </svg>
              </a>
            </div>
          </div>
        ))
      }
    </div>

    <p class="mt-3 flex items-center justify-center gap-1 text-[11px] text-[var(--color-muted)] sm:hidden">
      Deslizá para ver todos los estudios
      <svg
        width="12"
        height="12"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M5 12h14" />
        <path d="M13 6l6 6-6 6" />
      </svg>
    </p>
  </div>
</section>

<style>
  .servicios-hex-mask {
    mask-image: linear-gradient(to bottom, black 0%, black 45%, transparent 100%);
    -webkit-mask-image: linear-gradient(to bottom, black 0%, black 45%, transparent 100%);
  }

  .servicios-scroll {
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .servicios-scroll::-webkit-scrollbar {
    display: none;
  }

  .servicio-card {
    background-color: white;
    transition: background-image 300ms ease, background-color 300ms ease, border-color 300ms ease, box-shadow 300ms ease;
  }

  .servicio-card:hover,
  .servicio-card:focus-within {
    background-image: var(--gradient-navy);
    border-color: transparent;
    box-shadow: 0 16px 36px color-mix(in srgb, var(--color-blue) 30%, transparent);
  }

  .servicio-card-accent {
    background-image: linear-gradient(to right, var(--color-cyan), var(--color-blue));
    transition: width 300ms ease;
  }

  .servicio-card:hover .servicio-card-accent,
  .servicio-card:focus-within .servicio-card-accent {
    width: 100%;
  }

  .servicio-card-index {
    color: color-mix(in srgb, var(--color-blue) 12%, transparent);
    transition: color 300ms ease;
  }

  .servicio-card:hover .servicio-card-index,
  .servicio-card:focus-within .servicio-card-index {
    color: color-mix(in srgb, white 10%, transparent);
  }

  .servicio-card-tile {
    background-image: var(--gradient-blue);
    box-shadow: 0 10px 24px color-mix(in srgb, var(--color-blue) 35%, transparent);
    border: 1px solid transparent;
    transition: background-image 300ms ease, background-color 300ms ease, border-color 300ms ease, box-shadow 300ms ease;
  }

  .servicio-card:hover .servicio-card-tile,
  .servicio-card:focus-within .servicio-card-tile {
    background-image: none;
    background-color: rgba(255, 255, 255, 0.12);
    border-color: rgba(255, 255, 255, 0.2);
    box-shadow: none;
  }

  .servicio-card-icon,
  .servicio-card-title,
  .servicio-card-desc,
  .servicio-card-link {
    transition: color 300ms ease;
  }

  .servicio-card:hover .servicio-card-icon,
  .servicio-card:focus-within .servicio-card-icon {
    color: var(--color-cyan);
  }

  .servicio-card:hover .servicio-card-title,
  .servicio-card:focus-within .servicio-card-title {
    color: white;
  }

  .servicio-card:hover .servicio-card-desc,
  .servicio-card:focus-within .servicio-card-desc {
    color: rgba(255, 255, 255, 0.7);
  }

  .servicio-card:hover .servicio-card-link,
  .servicio-card:focus-within .servicio-card-link {
    color: var(--color-cyan);
  }

  @media (prefers-reduced-motion: reduce) {
    .servicio-card,
    .servicio-card-tile,
    .servicio-card-index,
    .servicio-card-icon,
    .servicio-card-title,
    .servicio-card-desc,
    .servicio-card-link {
      transition: color 150ms linear, background-color 150ms linear, border-color 150ms linear;
    }

    .servicio-card-accent {
      transition: none;
    }
  }
</style>
