---
import { servicios } from '../../data/servicios.js';
import HexPattern from '../ui/HexPattern.astro';
import SectionHeading from '../ui/SectionHeading.astro';

/** @type {Record<string, string>} */
const iconosPaths = {
  estomago:
    '<path d="M9 3v3.3c0 1.1-1.8 1.6-2.6 3.5-1.1 2.9.2 6 2.9 7.6a5.6 5.6 0 0 0 8-2.4c.7-1.5.2-3.1-1-4.1-.7-.6-1-1-1-1.9v-1.3c1.4-.1 2.5-.7 3-1.9" />',
  colon:
    '<path d="M5 19V7a3 3 0 0 1 3-3h6a3 3 0 0 1 3 3v8a3 3 0 0 1-3 3h-1a2 2 0 0 0-2 2v2" />',
  higado:
    '<path d="M5 7c1.5-2.5 6-3.5 10-2.5s5.5 3 5 5.5c-.4 2-2 3-4 3.8-2.3.9-3.5 2-4 4.2" /><path d="M8 18c-1.8-.2-3-1.3-3-3 0-1.6.5-3 1.2-4.3" /><path d="M14 15.5c-1 .8-1.3 2.3-.6 3.5.7 1.3 2.3 1.8 3.6 1.1 1.3-.7 1.8-2.3 1.1-3.6-.6-1.2-2-1.7-3.2-1.3" /><path d="M12.8 15.2l1.4.7" />',
  escudo:
    '<path d="M12 2.5l8.5 3.2v6.3c0 5-3.6 8.4-8.5 10-4.9-1.6-8.5-5-8.5-10V5.7l8.5-3.2Z" /><path d="M8.3 12.4l2.6 2.6 5.3-5.6" />',
};
---

<section id="servicios" class="relative bg-[var(--color-surface)] pt-14 pb-10 md:pt-24 md:pb-16 overflow-hidden">
  <HexPattern color="var(--color-blue)" opacity={0.04} />

  <div class="container relative">
    <SectionHeading
      eyebrow="NUESTROS SERVICIOS"
      titulo="Cuatro áreas clave para tu salud digestiva"
      tema="claro"
      alineacion="centro"
    />

    <div class="mt-[28px] md:mt-10 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-6">
      {
        servicios.map((servicio, index) => (
          <div
            class={`reveal reveal-delay-${Math.min(index, 4)} h-full flex flex-col bg-white border border-[var(--color-border)] rounded-[var(--radius)] shadow-[var(--shadow-card)] p-6 md:p-[26px] transition-all hover:border-[var(--color-blue)] hover:shadow-[var(--shadow-card-hover)] ${index === servicios.length - 1 ? 'mb-20 sm:mb-0' : ''}`}
          >
            <div class="w-12 h-12 md:w-14 md:h-14 rounded-full bg-[var(--color-navy)] flex items-center justify-center">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="white"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                class="w-[22px] h-[22px] md:w-[26px] md:h-[26px]"
                set:html={iconosPaths[servicio.icono]}
              />
            </div>

            <h3 class="mt-5 text-[var(--color-ink)] max-w-[22ch] leading-[1.3] min-h-[2.6em]">{servicio.titulo}</h3>

            <p class="mt-3 text-[14px] text-[var(--color-muted)] leading-[1.6] max-w-none flex-1">
              {servicio.descripcion}
            </p>

            <a
              href="#pacientes"
              class="group mt-auto pt-5 inline-flex items-center gap-1.5 text-[14px] font-semibold text-[var(--color-blue)]"
            >
              Ver preparación
              <svg
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                class="transition-transform group-hover:translate-x-1"
                aria-hidden="true"
              >
                <path d="M5 12h14" />
                <path d="M13 6l6 6-6 6" />
              </svg>
            </a>
          </div>
        ))
      }
    </div>
  </div>
</section>
