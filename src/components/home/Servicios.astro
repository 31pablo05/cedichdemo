---
import { serviciosEncabezado, serviciosAcciones, gruposServicios } from '../../data/servicios.js';
import { getWhatsappLink } from '../../data/site.js';
import HexPattern from '../ui/HexPattern.astro';
import SectionHeading from '../ui/SectionHeading.astro';

// Numeración continua 01 a 05 a través de los dos grupos
let contador = 0;
const grupos = gruposServicios.map((grupo) => ({
  ...grupo,
  estudios: grupo.estudios.map((estudio) => ({
    ...estudio,
    numero: String(++contador).padStart(2, '0'),
    whatsappLink: getWhatsappLink(estudio.mensajeWhatsapp),
  })),
}));
---

<section id="servicios" class="relative bg-[var(--color-surface)] pt-14 pb-14 md:pt-24 md:pb-20 overflow-hidden">
  <!-- Franja de transición desde el hero oscuro -->
  <div class="pointer-events-none absolute inset-x-0 top-0 h-20" style={{ backgroundImage: 'linear-gradient(to bottom, white 0%, var(--color-surface) 100%)' }}></div>

  <!-- Resplandor radial azul muy tenue, arriba -->
  <div
    class="pointer-events-none absolute inset-x-0 top-0 h-[520px]"
    style={{
      backgroundImage:
        'radial-gradient(60% 60% at 50% 0%, color-mix(in srgb, var(--color-blue) 10%, transparent) 0%, transparent 100%)',
    }}
  ></div>

  <div class="servicios-hex-mask absolute inset-0 pointer-events-none">
    <HexPattern color="var(--color-blue)" opacity={0.05} />
  </div>

  <!-- Sin JavaScript, las cards se ven en su posición final -->
  <noscript>
    <style is:inline>
      #servicios .reveal { opacity: 1; transform: none; }
    </style>
  </noscript>

  <div class="container relative">
    <SectionHeading
      eyebrow={serviciosEncabezado.eyebrow}
      titulo={serviciosEncabezado.titulo}
      bajada={serviciosEncabezado.bajada}
      tema="claro"
      alineacion="centro"
      equilibrado
    />

    <!--
      Endoscópicos: apiladas en mobile, 2 columnas desde tablet.
      Tests: apiladas en mobile; en tablet 2 columnas con la tercera a todo el ancho; 3 columnas desde desktop.
    -->
    {
      grupos.map((grupo, indiceGrupo) => (
        <div class={indiceGrupo === 0 ? 'mt-9 md:mt-12' : 'mt-10 md:mt-14'}>
          <div class="flex items-center gap-4">
            <h3 class="eyebrow eyebrow-dark shrink-0">{grupo.nombre}</h3>
            <span class="h-px flex-1 bg-[var(--color-border)]" aria-hidden="true" />
          </div>

          <!--
            Card: texto (número, título, descripción) y acciones.
            Mobile: número y título en una línea; botón corto y link en una fila.
            Tablet y desktop: columna con el botón a todo el ancho.
            Endoscópicos desde desktop: texto a la izquierda y acciones a la derecha.
          -->
          <div class={`mt-4 grid grid-cols-1 gap-3 md:mt-5 md:grid-cols-2 md:gap-6 ${grupo.destacado ? '' : 'lg:grid-cols-3'}`}>
            {grupo.estudios.map((estudio, index) => (
              <article
                class:list={[
                  'servicio-card reveal relative flex h-full flex-col overflow-hidden rounded-[var(--radius)] border border-[var(--color-border)] bg-white shadow-[var(--shadow-card)]',
                  `reveal-delay-${index}`,
                  grupo.destacado
                    ? 'servicio-card--destacado p-5 md:p-8 lg:grid lg:grid-cols-[minmax(0,1fr)_auto] lg:gap-x-10'
                    : 'p-4 md:p-6',
                  !grupo.destacado && index === 2 && 'md:col-span-2 lg:col-span-1',
                ]}
              >
                <div class={`flex flex-1 flex-col ${grupo.destacado ? 'lg:self-center' : ''}`}>
                  <div class="flex items-baseline gap-2.5 md:block">
                    <span class="servicio-numero font-display text-[17px] font-bold leading-none md:text-[22px]" aria-hidden="true">
                      {estudio.numero}
                    </span>

                    <h4 class={`servicio-card-title text-balance text-[var(--color-ink)] md:mt-3 ${grupo.destacado ? 'text-[19px] md:text-[22px]' : 'text-[18px]'}`}>
                      {estudio.titulo}
                    </h4>
                  </div>

                  <p class="servicio-card-desc mt-2 max-w-none text-[15px] leading-[1.6] md:mt-2.5">
                    {estudio.descripcion}
                  </p>
                </div>

                <div class={`mt-4 flex items-center justify-between gap-3 md:mt-6 md:flex-col md:items-stretch md:gap-1 ${grupo.destacado ? 'lg:mt-0 lg:items-center lg:self-center' : ''}`}>
                  <a
                    href={estudio.whatsappLink}
                    target="_blank"
                    rel="noopener noreferrer"
                    class={`servicio-card-cta inline-flex min-h-[44px] items-center justify-center gap-2 whitespace-nowrap rounded-[var(--radius-pill)] bg-[var(--color-blue)] px-5 py-2.5 text-[14px] font-semibold text-white md:w-full md:px-4 ${grupo.destacado ? 'lg:w-auto lg:px-7' : ''}`}
                  >
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38a9.9 9.9 0 0 0 4.74 1.21h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.86 9.86 0 0 0 12.04 2Zm0 1.67c2.19 0 4.25.85 5.8 2.4a8.18 8.18 0 0 1 2.41 5.84c0 4.55-3.7 8.24-8.24 8.24a8.3 8.3 0 0 1-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.55 3.7-8.24 8.28-8.24Zm-4.53 4.7c-.16 0-.42.06-.64.3-.22.24-.85.83-.85 2.02 0 1.19.87 2.34 1 2.5.12.16 1.7 2.6 4.13 3.64 2.04.87 2.46.7 2.9.65.44-.04 1.42-.58 1.62-1.14.2-.56.2-1.04.14-1.14-.06-.1-.22-.16-.46-.28-.24-.12-1.42-.7-1.64-.78-.22-.08-.38-.12-.54.12-.16.24-.62.78-.76.94-.14.16-.28.18-.52.06-.24-.12-1.02-.38-1.94-1.2-.72-.64-1.2-1.44-1.34-1.68-.14-.24-.02-.37.1-.5.11-.1.24-.28.36-.42.12-.14.16-.24.24-.4.08-.16.04-.3-.02-.42-.06-.12-.54-1.32-.75-1.8-.2-.47-.4-.4-.55-.4h-.48Z" />
                    </svg>
                    <span>{serviciosAcciones.consultar}<span class="servicio-cta-detalle">{serviciosAcciones.consultarDetalle}</span></span>
                  </a>

                  <a
                    href={`#preparacion-${estudio.id}`}
                    class="servicio-card-link inline-flex min-h-[44px] items-center justify-center gap-1.5 rounded-[var(--radius-sm)] px-2 text-[13px] font-semibold text-[var(--color-blue-dark)] md:self-center"
                  >
                    {serviciosAcciones.verPreparacion}
                    <svg
                      class="servicio-card-link-arrow"
                      width="14"
                      height="14"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="M5 12h14" />
                      <path d="M13 6l6 6-6 6" />
                    </svg>
                  </a>
                </div>
              </article>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</section>

<style>
  .servicios-hex-mask {
    mask-image: linear-gradient(to bottom, black 0%, black 45%, transparent 100%);
    -webkit-mask-image: linear-gradient(to bottom, black 0%, black 45%, transparent 100%);
  }

  .servicio-card {
    transition: border-color 220ms ease, box-shadow 220ms ease;
  }

  /* Franja cyan superior: marca los estudios principales */
  .servicio-card--destacado::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 3px;
    background-color: var(--color-cyan);
  }

  .servicio-numero {
    color: var(--color-blue);
    letter-spacing: 0.02em;
  }

  .servicio-card-title {
    font-family: var(--font-display);
    font-weight: 600;
    line-height: 1.25;
    max-width: none;
  }

  /* Gris de descripción más oscuro que --color-muted: 7,6:1 sobre blanco */
  .servicio-card-desc {
    color: color-mix(in srgb, var(--color-ink) 25%, var(--color-muted));
  }

  /* Mobile: el botón muestra solo "Consultar"; el resto lo siguen leyendo los lectores de pantalla */
  @media (max-width: 767.98px) {
    .servicio-cta-detalle {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }

  .servicio-card-cta {
    transition: background-color 220ms ease;
  }

  .servicio-card-link-arrow {
    transition: transform 200ms ease;
  }

  /* Hover solo con mouse: en pantallas táctiles no queda ningún estado marcado al tocar */
  @media (hover: hover) and (pointer: fine) {
    .servicio-card:hover {
      border-color: var(--color-blue);
      box-shadow: var(--shadow-card-hover);
    }

    .servicio-card-cta:hover {
      background-color: var(--color-blue-dark);
    }

    .servicio-card-link:hover .servicio-card-link-arrow {
      transform: translateX(3px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .servicio-card,
    .servicio-card-cta,
    .servicio-card-link-arrow {
      transition: none;
    }

    .servicio-card-link:hover .servicio-card-link-arrow {
      transform: none;
    }
  }
</style>
