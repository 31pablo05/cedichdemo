---
import { trayectoria } from '../../data/profesionales.js';
---

<section
  id="trayectoria"
  data-seccion-de="profesionales"
  class="relative bg-white py-14 md:py-24 overflow-hidden"
>
  <div class="container relative">
    <div class="lg:grid lg:grid-cols-[minmax(0,30fr)_minmax(0,70fr)] lg:gap-12 xl:gap-16">
      <!-- Columna izquierda: título -->
      <div class="lg:sticky lg:top-28">
        <p class="text-[11px] font-semibold uppercase tracking-[0.14em] text-[var(--color-blue)]">
          {trayectoria.profesional}
        </p>
        <h2 class="mt-3 text-[var(--color-ink)]">{trayectoria.titulo}</h2>
      </div>

      <!-- Columna derecha: línea de tiempo -->
      <div class="mt-10 lg:mt-0">
        <ol class="relative flex flex-col gap-0">
          {
            trayectoria.etapas.map((etapa, index) => {
              const esUltimo = index === trayectoria.etapas.length - 1;
              return (
                <li class="relative flex gap-6 pb-10 last:pb-0">
                  {/* Punto y línea */}
                  <div class="relative flex flex-col items-center">
                    {/* Punto */}
                    <div
                      class={`trayectoria-punto relative z-10 flex h-4 w-4 shrink-0 items-center justify-center rounded-full border-2 ${
                        esUltimo
                          ? 'border-[var(--color-cyan)] bg-[var(--color-cyan)]'
                          : 'border-[var(--color-cyan)] bg-white'
                      }`}
                    >
                      {esUltimo && (
                        <span class="absolute h-2 w-2 rounded-full bg-white" />
                      )}
                    </div>

                    {/* Línea vertical */}
                    {!esUltimo && (
                      <span class="trayectoria-linea mt-1 w-[2px] flex-1 bg-[var(--color-cyan)]/25" />
                    )}
                  </div>

                  {/* Contenido */}
                  <div class="flex-1 -mt-[2px]">
                    <p class="text-[14px] font-semibold text-[var(--color-blue-dark)]">
                      {etapa.lugar} · {etapa.institucion}
                    </p>
                    <p class="mt-2 text-[15px] leading-[1.6] text-[var(--color-muted)] max-w-[58ch]">
                      {etapa.descripcion}
                    </p>
                  </div>
                </li>
              );
            })
          }
        </ol>
      </div>
    </div>
  </div>
</section>

<style>
  /* El último punto tiene un efecto de pulso suave para marcar "actualidad" */
  .trayectoria-punto:last-of-type {
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--color-cyan) 15%, transparent);
  }
</style>
