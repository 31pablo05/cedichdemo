---
import { obrasSociales, notaCobertura } from '../../data/obrasSociales.js';
import { getWhatsappLink } from '../../data/site.js';

const whatsappLink = getWhatsappLink('Hola, quiero consultar si trabajan con mi obra social');
---

<div class="h-full bg-white border border-[var(--color-border)] rounded-[var(--radius)] shadow-[var(--shadow-card)] p-7">
  <p class="eyebrow eyebrow-dark">OBRAS SOCIALES</p>
  <h2 class="mt-4 text-[24px] font-display text-[var(--color-ink)]">
    Trabajamos con obras sociales y prepagas
  </h2>

  <p class="mt-5 text-[14px] text-[var(--color-muted)] max-w-none">{notaCobertura}</p>

  <div class="mt-5 grid grid-cols-2 gap-2.5">
    {
      obrasSociales.map((nombre) => (
        <span class="bg-[var(--color-surface)] border border-[var(--color-border)] rounded-[var(--radius-sm)] px-4 py-2.5 text-[14px] font-semibold text-[var(--color-muted)] text-center">
          {nombre}
        </span>
      ))
    }
  </div>

  <a
    href={whatsappLink}
    target="_blank"
    rel="noopener noreferrer"
    class="mt-6 inline-flex items-center justify-center gap-2 w-full rounded-[var(--radius-pill)] bg-white border-[1.5px] border-[var(--color-border)] text-[var(--color-ink)] px-6 py-3 font-medium"
  >
    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38a9.9 9.9 0 0 0 4.74 1.21h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.86 9.86 0 0 0 12.04 2Zm0 1.67c2.19 0 4.25.85 5.8 2.4a8.18 8.18 0 0 1 2.41 5.84c0 4.55-3.7 8.24-8.24 8.24a8.3 8.3 0 0 1-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.55 3.7-8.24 8.28-8.24Zm-4.53 4.7c-.16 0-.42.06-.64.3-.22.24-.85.83-.85 2.02 0 1.19.87 2.34 1 2.5.12.16 1.7 2.6 4.13 3.64 2.04.87 2.46.7 2.9.65.44-.04 1.42-.58 1.62-1.14.2-.56.2-1.04.14-1.14-.06-.1-.22-.16-.46-.28-.24-.12-1.42-.7-1.64-.78-.22-.08-.38-.12-.54.12-.16.24-.62.78-.76.94-.14.16-.28.18-.52.06-.24-.12-1.02-.38-1.94-1.2-.72-.64-1.2-1.44-1.34-1.68-.14-.24-.02-.37.1-.5.11-.1.24-.28.36-.42.12-.14.16-.24.24-.4.08-.16.04-.3-.02-.42-.06-.12-.54-1.32-.75-1.8-.2-.47-.4-.4-.55-.4h-.48Z" />
    </svg>
    Consultar mi cobertura
  </a>
</div>
