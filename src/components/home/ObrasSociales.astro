---
import { obrasSocialesTextos } from '../../data/obrasSociales.js';
import { getWhatsappLink, whatsappMensajes } from '../../data/site.js';
import HexPattern from '../ui/HexPattern.astro';

const whatsappLink = getWhatsappLink(whatsappMensajes.consultaCobertura);
---

<div class="obras-card relative flex flex-col overflow-hidden rounded-[var(--radius)] bg-[var(--color-navy-deep)] p-5 shadow-[var(--shadow-card)] md:p-7">
  <HexPattern color="var(--color-cyan)" opacity={0.07} />

  <div class="relative">
    <p class="eyebrow eyebrow-light">{obrasSocialesTextos.eyebrow}</p>
    <h2 class="mt-4 font-display text-[24px] text-white">{obrasSocialesTextos.titulo}</h2>

    <p class="mt-4 max-w-none text-[15px] leading-[1.6] text-white/80">{obrasSocialesTextos.linea}</p>

    <!-- Paso a paso para consultar cobertura -->
    <ol class="mt-6 flex flex-col gap-3.5">
      {
        obrasSocialesTextos.pasos.map((paso, index) => (
          <li class="flex items-start gap-3">
            <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-[var(--color-cyan)] text-[13px] font-bold text-[var(--color-navy-deep)]">
              {index + 1}
            </span>
            <span class="pt-[3px] text-[15px] leading-[1.45] text-white/90">{paso}</span>
          </li>
        ))
      }
    </ol>

    {
      /*
        PENDIENTE CLIENTE: zona de logos de obras sociales (lista en obrasSociales.js).
        No mostrar nombres ni logos reales hasta confirmar convenios vigentes.
        <ul class="mt-6 flex flex-wrap gap-2">
          {obrasSociales.map((nombre) => <li>{nombre}</li>)}
        </ul>
      */
    }

    <a
      href={whatsappLink}
      target="_blank"
      rel="noopener noreferrer"
      class="obras-cta mt-7 inline-flex min-h-[48px] w-full items-center justify-center gap-2 whitespace-nowrap rounded-[var(--radius-pill)] bg-white px-4 text-[15px] font-semibold text-[var(--color-ink)] sm:px-6"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" class="shrink-0" aria-hidden="true">
        <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38a9.9 9.9 0 0 0 4.74 1.21h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.86 9.86 0 0 0 12.04 2Zm0 1.67c2.19 0 4.25.85 5.8 2.4a8.18 8.18 0 0 1 2.41 5.84c0 4.55-3.7 8.24-8.24 8.24a8.3 8.3 0 0 1-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.55 3.7-8.24 8.28-8.24Zm-4.53 4.7c-.16 0-.42.06-.64.3-.22.24-.85.83-.85 2.02 0 1.19.87 2.34 1 2.5.12.16 1.7 2.6 4.13 3.64 2.04.87 2.46.7 2.9.65.44-.04 1.42-.58 1.62-1.14.2-.56.2-1.04.14-1.14-.06-.1-.22-.16-.46-.28-.24-.12-1.42-.7-1.64-.78-.22-.08-.38-.12-.54.12-.16.24-.62.78-.76.94-.14.16-.28.18-.52.06-.24-.12-1.02-.38-1.94-1.2-.72-.64-1.2-1.44-1.34-1.68-.14-.24-.02-.37.1-.5.11-.1.24-.28.36-.42.12-.14.16-.24.24-.4.08-.16.04-.3-.02-.42-.06-.12-.54-1.32-.75-1.8-.2-.47-.4-.4-.55-.4h-.48Z" />
      </svg>
      {obrasSocialesTextos.boton}
    </a>
  </div>
</div>

<style>
  .obras-cta {
    transition: background-color 200ms ease, box-shadow 200ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .obras-cta:hover {
      background-color: var(--color-surface);
      box-shadow: var(--shadow-card-hover);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .obras-cta {
      transition: none;
    }
  }
</style>
