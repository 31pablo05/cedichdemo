---
import { pasos } from '../../data/pasos.js';
import { preparacion } from '../../data/preparacion.js';
import SectionHeading from '../ui/SectionHeading.astro';
import PreparacionAccordion from './PreparacionAccordion.jsx';

/** @type {Record<string, string>} */
const iconosPaths = {
  chat: '<path d="M4 5h16v11H8l-4 4V5Z" />',
  lista: '<path d="M8 6h12M8 12h12M8 18h12" /><path d="M4 6h.01M4 12h.01M4 18h.01" />',
  preparacion: '<path d="M9 3h6v4H9z" /><path d="M7 7h10l1 13H6L7 7Z" /><path d="M9 12h6" />',
  monitor: '<rect x="3" y="4" width="18" height="12" rx="1.5" /><path d="M8 20h8" /><path d="M12 16v4" />',
  check: '<circle cx="12" cy="12" r="9" /><path d="M8 12.5l2.5 2.5 5-5" />',
};

const ultimoIndex = pasos.length - 1;
---

<section id="pacientes" class="bg-[var(--color-surface)] py-14 md:py-24">
  <div class="container">
    <SectionHeading
      eyebrow="PREPARACIÓN PARA ESTUDIOS"
      titulo="Te acompañamos en cada paso"
      bajada="Desde que pedís el turno hasta que recibís los resultados."
      tema="claro"
      alineacion="centro"
    />

    <div class="mt-12 flex flex-col lg:mt-16 lg:flex-row lg:gap-6">
      {
        pasos.map((paso, index) => (
          <div class="flex gap-4 pb-8 last:pb-0 lg:flex-1 lg:flex-col lg:gap-0 lg:pb-0">
            <div class="flex flex-col items-center lg:w-full lg:flex-row lg:items-start">
              <div class="paso-circle relative flex h-[42px] w-[42px] shrink-0 items-center justify-center rounded-full lg:h-[52px] lg:w-[52px]">
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="white"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  class="h-5 w-5 lg:h-6 lg:w-6"
                  set:html={iconosPaths[paso.icono]}
                />
              </div>

              {index !== ultimoIndex && (
                <span class="paso-linea mt-1 min-h-[24px] w-[2px] flex-1 lg:mt-[25px] lg:h-[2px] lg:w-auto lg:min-h-0" />
              )}
            </div>

            <div class="lg:mt-4">
              <p class="paso-label">PASO {String(paso.numero).padStart(2, '0')}</p>
              <h3 class="mt-1 text-[16px] text-[var(--color-ink)]">{paso.titulo}</h3>
              <p class="mt-1.5 text-[14px] leading-[1.6] text-[var(--color-muted)]">{paso.descripcion}</p>
            </div>
          </div>
        ))
      }
    </div>

    <div class="mt-14 border-t border-[var(--color-border)] pt-10 lg:mt-20">
      <p class="paso-label">INDICACIONES</p>
      <h3 class="mt-3 text-[22px] text-[var(--color-ink)]">Preparación según el estudio</h3>
      <p class="mt-2 text-[14px] text-[var(--color-muted)] max-w-none">
        Información orientativa. Las indicaciones definitivas te las enviamos por WhatsApp según tu
        caso.
      </p>

      <div class="mt-6">
        <PreparacionAccordion estudios={preparacion} client:visible />
      </div>

      <div class="mt-8 flex items-start gap-3 bg-white border-l-[3px] border-[var(--color-blue)] rounded-[var(--radius-sm)] p-[18px]">
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="var(--color-blue)"
          stroke-width="1.5"
          class="shrink-0"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="9" />
          <path d="M12 11v5" />
          <path d="M12 8h.01" />
        </svg>
        <p class="text-[14px] text-[var(--color-muted)] max-w-none">
          Esta información es orientativa y no reemplaza la indicación de tu médico. Ante cualquier
          duda, escribinos.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .paso-circle {
    background-image: var(--gradient-blue);
    box-shadow: 0 10px 24px color-mix(in srgb, var(--color-blue) 35%, transparent);
  }

  .paso-linea {
    background-color: color-mix(in srgb, var(--color-blue) 18%, white);
  }

  .paso-label {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-blue-dark);
  }
</style>
