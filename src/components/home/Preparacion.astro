---
import { pasos } from '../../data/pasos.js';
import { preparacion } from '../../data/preparacion.js';
import SectionHeading from '../ui/SectionHeading.astro';
import PreparacionAccordion from './PreparacionAccordion.jsx';

/** @type {Record<string, string>} */
const iconosPaths = {
  chat: '<path d="M4 5h16v11H8l-4 4V5Z" />',
  lista: '<path d="M8 6h12M8 12h12M8 18h12" /><path d="M4 6h.01M4 12h.01M4 18h.01" />',
  preparacion: '<path d="M9 3h6v4H9z" /><path d="M7 7h10l1 13H6L7 7Z" /><path d="M9 12h6" />',
  monitor: '<rect x="3" y="4" width="18" height="12" rx="1.5" /><path d="M8 20h8" /><path d="M12 16v4" />',
  check: '<circle cx="12" cy="12" r="9" /><path d="M8 12.5l2.5 2.5 5-5" />',
};
---

<section id="pacientes" class="bg-[var(--color-surface)] py-14 md:py-24">
  <div class="container">
    <div class="flex flex-col lg:flex-row gap-8 lg:gap-10">
      <div class="lg:w-[26%]">
        <SectionHeading
          eyebrow="PREPARACIÓN PARA ESTUDIOS"
          titulo="Te acompañamos en cada paso"
          bajada="Desde que pedís el turno hasta que recibís los resultados."
          tema="claro"
          alineacion="izquierda"
        />
      </div>

      <div class="lg:w-[74%] w-full bg-white border border-[var(--color-border)] rounded-[var(--radius)] shadow-[var(--shadow-card)] p-7">
        <div class="flex flex-col lg:flex-row">
          {
            pasos.map((paso, index) => (
              <div
                class={`flex-1 py-5 lg:py-0 lg:px-6 ${
                  index !== 0 ? 'border-t lg:border-t-0 lg:border-l border-[var(--color-border)]' : ''
                }`}
              >
                <div class="flex items-center gap-3">
                  <span class="flex items-center justify-center w-[26px] h-[26px] rounded-full bg-[var(--color-blue)] text-white text-[13px] font-bold shrink-0">
                    {paso.numero}
                  </span>
                  <svg
                    width="28"
                    height="28"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="var(--color-blue)"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                    set:html={iconosPaths[paso.icono]}
                  />
                </div>

                <h3 class="mt-3.5 text-[14px] font-bold text-[var(--color-ink)]">{paso.titulo}</h3>
                <p class="mt-2 text-[13px] text-[var(--color-muted)] leading-[1.6] max-w-none">
                  {paso.descripcion}
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </div>

    <div class="mt-10">
      <h3 class="text-[20px] text-[var(--color-ink)]">Preparación según el estudio</h3>
      <p class="mt-2 text-[14px] text-[var(--color-muted)] max-w-none">
        Información orientativa. Las indicaciones definitivas te las enviamos por WhatsApp según tu
        caso.
      </p>

      <div class="mt-6">
        <PreparacionAccordion estudios={preparacion} client:visible />
      </div>

      <div class="mt-8 flex items-start gap-3 bg-white border-l-[3px] border-[var(--color-blue)] rounded-[var(--radius-sm)] p-[18px]">
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="var(--color-blue)"
          stroke-width="1.5"
          class="shrink-0"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="9" />
          <path d="M12 11v5" />
          <path d="M12 8h.01" />
        </svg>
        <p class="text-[14px] text-[var(--color-muted)] max-w-none">
          Esta información es orientativa y no reemplaza la indicación de tu médico. Ante cualquier
          duda, escribinos.
        </p>
      </div>
    </div>
  </div>
</section>
