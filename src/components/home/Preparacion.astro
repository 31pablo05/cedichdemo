---
import { pasos } from '../../data/pasos.js';
import { preparacion, preparacionTextos } from '../../data/preparacion.js';
import { getWhatsappLink, whatsappMensajes } from '../../data/site.js';
import SectionHeading from '../ui/SectionHeading.astro';
import PreparacionAccordion from './PreparacionAccordion.jsx';

const whatsappPreparacion = getWhatsappLink(whatsappMensajes.consultaPreparacion);

/** @type {Record<string, string>} */
const iconosPaths = {
  chat: '<path d="M4 5h16v11H8l-4 4V5Z" />',
  lista: '<path d="M8 6h12M8 12h12M8 18h12" /><path d="M4 6h.01M4 12h.01M4 18h.01" />',
  preparacion: '<path d="M9 3h6v4H9z" /><path d="M7 7h10l1 13H6L7 7Z" /><path d="M9 12h6" />',
  monitor: '<rect x="3" y="4" width="18" height="12" rx="1.5" /><path d="M8 20h8" /><path d="M12 16v4" />',
  check: '<circle cx="12" cy="12" r="9" /><path d="M8 12.5l2.5 2.5 5-5" />',
};

const ultimoIndex = pasos.length - 1;
---

<section id="pacientes" class="bg-[var(--color-surface)] py-14 md:py-24">
  <div class="container">
    <SectionHeading
      eyebrow="PREPARACIÓN PARA ESTUDIOS"
      titulo="Te acompañamos en cada paso"
      bajada="Desde que pedís el turno hasta que recibís los resultados."
      tema="claro"
      alineacion="centro"
    />

    <div class="mt-12 flex flex-col lg:mt-16 lg:flex-row lg:gap-6">
      {
        pasos.map((paso, index) => (
          <div class={`reveal reveal-delay-${Math.min(index, 4)} flex gap-4 pb-8 last:pb-0 lg:flex-1 lg:flex-col lg:gap-0 lg:pb-0`}>
            <div class="flex flex-col items-center lg:w-full lg:flex-row lg:items-start">
              <div class="paso-circle relative flex h-[42px] w-[42px] shrink-0 items-center justify-center rounded-full lg:h-[52px] lg:w-[52px]">
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="white"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  class="h-5 w-5 lg:h-6 lg:w-6"
                  set:html={iconosPaths[paso.icono]}
                />
              </div>

              {index !== ultimoIndex && (
                <span class="paso-linea mt-1 min-h-[24px] w-[2px] flex-1 lg:mt-[25px] lg:h-[2px] lg:w-auto lg:min-h-0" />
              )}
            </div>

            <div class="lg:mt-4">
              <p class="paso-label">PASO {String(paso.numero).padStart(2, '0')}</p>
              <h3 class="mt-1 text-[17px] text-[var(--color-ink)]">{paso.titulo}</h3>
              <p class="mt-1.5 text-[15px] leading-[1.6] text-[var(--color-muted)]">{paso.descripcion}</p>
            </div>
          </div>
        ))
      }
    </div>

    <!--
      Preparación según el estudio
      Mobile y tablet: una columna (encabezado, acordeón, aviso y botón).
      Desktop: columna izquierda fija con encabezado, aviso y botón; acordeón a la derecha.
    -->
    <div class="prep-bloque mt-14 flex flex-col border-t border-[var(--color-border)] pt-10 lg:mt-20 lg:pt-14">
      <div class="prep-lateral">
        <div class="prep-encabezado">
          <p class="paso-label">{preparacionTextos.eyebrow}</p>
          <h3 class="mt-3 text-[22px] text-[var(--color-ink)]">{preparacionTextos.titulo}</h3>
          <p class="prep-texto mt-2 max-w-none text-[15px] leading-[1.6]">{preparacionTextos.intro}</p>
        </div>

        <div class="prep-pie">
          <div class="flex items-start gap-3 rounded-[var(--radius-sm)] border-l-[3px] border-[var(--color-blue)] bg-white p-[18px]">
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="var(--color-blue)"
              stroke-width="1.5"
              class="mt-[1px] shrink-0"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="9" />
              <path d="M12 11v5" />
              <path d="M12 8h.01" />
            </svg>
            <p class="prep-texto max-w-none text-[15px] leading-[1.6]">{preparacionTextos.aviso}</p>
          </div>

          <a
            href={whatsappPreparacion}
            target="_blank"
            rel="noopener noreferrer"
            class="prep-cta mt-5 inline-flex min-h-[48px] w-full items-center justify-center gap-2 whitespace-nowrap rounded-[var(--radius-pill)] bg-white px-6 text-[15px] font-semibold text-[var(--color-ink)]"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38a9.9 9.9 0 0 0 4.74 1.21h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.86 9.86 0 0 0 12.04 2Zm0 1.67c2.19 0 4.25.85 5.8 2.4a8.18 8.18 0 0 1 2.41 5.84c0 4.55-3.7 8.24-8.24 8.24a8.3 8.3 0 0 1-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.55 3.7-8.24 8.28-8.24Zm-4.53 4.7c-.16 0-.42.06-.64.3-.22.24-.85.83-.85 2.02 0 1.19.87 2.34 1 2.5.12.16 1.7 2.6 4.13 3.64 2.04.87 2.46.7 2.9.65.44-.04 1.42-.58 1.62-1.14.2-.56.2-1.04.14-1.14-.06-.1-.22-.16-.46-.28-.24-.12-1.42-.7-1.64-.78-.22-.08-.38-.12-.54.12-.16.24-.62.78-.76.94-.14.16-.28.18-.52.06-.24-.12-1.02-.38-1.94-1.2-.72-.64-1.2-1.44-1.34-1.68-.14-.24-.02-.37.1-.5.11-.1.24-.28.36-.42.12-.14.16-.24.24-.4.08-.16.04-.3-.02-.42-.06-.12-.54-1.32-.75-1.8-.2-.47-.4-.4-.55-.4h-.48Z" />
            </svg>
            {preparacionTextos.boton}
          </a>
        </div>
      </div>

      <div class="prep-acordeon">
        <PreparacionAccordion estudios={preparacion} client:visible />
      </div>
    </div>
  </div>
</section>

<style>
  .paso-circle {
    background-image: var(--gradient-blue);
    box-shadow: 0 10px 24px color-mix(in srgb, var(--color-blue) 35%, transparent);
  }

  .paso-linea {
    background-color: color-mix(in srgb, var(--color-blue) 18%, white);
  }

  .paso-label {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-blue-dark);
  }

  /* Gris más oscuro que --color-muted: 7,6:1 sobre blanco */
  .prep-texto {
    color: color-mix(in srgb, var(--color-ink) 25%, var(--color-muted));
  }

  /* Mobile y tablet: la columna lateral se disuelve para ubicar aviso y botón después del acordeón */
  @media (max-width: 1023.98px) {
    .prep-lateral {
      display: contents;
    }

    .prep-encabezado {
      order: 1;
    }

    .prep-acordeon {
      order: 2;
      margin-top: 24px;
    }

    .prep-pie {
      order: 3;
      margin-top: 32px;
    }
  }

  /* Desktop: 35 / 65, con la columna izquierda fija debajo del header */
  @media (min-width: 1024px) {
    .prep-bloque {
      display: grid;
      grid-template-columns: minmax(0, 35fr) minmax(0, 65fr);
      column-gap: 56px;
      align-items: start;
    }

    .prep-lateral {
      position: sticky;
      top: 112px;
    }

    .prep-pie {
      margin-top: 28px;
    }
  }

  @media (min-width: 1280px) {
    .prep-bloque {
      column-gap: 72px;
    }
  }

  .prep-cta {
    border: 1.5px solid var(--color-border);
    transition: background-color 200ms ease, border-color 200ms ease, color 200ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .prep-cta:hover {
      border-color: var(--color-blue);
      background-color: var(--color-blue);
      color: var(--color-white);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .prep-cta {
      transition: none;
    }
  }
</style>
