---
import { faq, faqTextos, respuestaEnTexto } from '../../data/faq.js';
import { getWhatsappLink, whatsappMensajes } from '../../data/site.js';
import Faq from './Faq.jsx';
import ObrasSociales from './ObrasSociales.astro';

const whatsappConsulta = getWhatsappLink(whatsappMensajes.consultaGeneral);

// Datos estructurados FAQPage, con el texto plano de cada respuesta
const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.pregunta,
    acceptedAnswer: { '@type': 'Answer', text: respuestaEnTexto(item) },
  })),
};
---

<section class="bg-white py-14 md:py-24">
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />

  <!--
    Desktop: preguntas 60 % y columna derecha 40 %, alineadas arriba y abajo.
    La tarjeta de ayuda se estira para completar la altura de las preguntas (también al abrir una).
  -->
  <div class="container">
    <div class="grid grid-cols-1 gap-6 lg:grid-cols-[minmax(0,60fr)_minmax(0,40fr)]">
      <Faq items={faq} textos={faqTextos} whatsappLink={whatsappConsulta} client:visible />

      <div class="flex flex-col gap-6">
        <ObrasSociales />

        <div class="hidden flex-1 flex-col justify-center rounded-[var(--radius)] border border-[var(--color-border)] bg-white p-6 shadow-[var(--shadow-card)] lg:flex">
          <div class="flex items-center gap-3">
            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-[var(--color-cyan-pale)]">
              <svg
                width="22"
                height="22"
                viewBox="0 0 24 24"
                fill="none"
                stroke="var(--color-blue-dark)"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M4 5h16v11H8l-4 4V5Z" />
                <path d="M8 9.5h8M8 12.5h5" />
              </svg>
            </span>
            <h3 class="text-[19px] text-[var(--color-ink)]">{faqTextos.ayudaTitulo}</h3>
          </div>
          <p class="ayuda-texto mt-3 max-w-none text-[15px] leading-[1.55]">{faqTextos.ayudaTexto}</p>
          <a
            href={whatsappConsulta}
            target="_blank"
            rel="noopener noreferrer"
            class="ayuda-cta mt-5 inline-flex min-h-[48px] w-full items-center justify-center gap-2 whitespace-nowrap rounded-[var(--radius-pill)] bg-white px-6 text-[15px] font-semibold text-[var(--color-ink)]"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" class="shrink-0" aria-hidden="true">
              <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38a9.9 9.9 0 0 0 4.74 1.21h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.86 9.86 0 0 0 12.04 2Zm0 1.67c2.19 0 4.25.85 5.8 2.4a8.18 8.18 0 0 1 2.41 5.84c0 4.55-3.7 8.24-8.24 8.24a8.3 8.3 0 0 1-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.55 3.7-8.24 8.28-8.24Zm-4.53 4.7c-.16 0-.42.06-.64.3-.22.24-.85.83-.85 2.02 0 1.19.87 2.34 1 2.5.12.16 1.7 2.6 4.13 3.64 2.04.87 2.46.7 2.9.65.44-.04 1.42-.58 1.62-1.14.2-.56.2-1.04.14-1.14-.06-.1-.22-.16-.46-.28-.24-.12-1.42-.7-1.64-.78-.22-.08-.38-.12-.54.12-.16.24-.62.78-.76.94-.14.16-.28.18-.52.06-.24-.12-1.02-.38-1.94-1.2-.72-.64-1.2-1.44-1.34-1.68-.14-.24-.02-.37.1-.5.11-.1.24-.28.36-.42.12-.14.16-.24.24-.4.08-.16.04-.3-.02-.42-.06-.12-.54-1.32-.75-1.8-.2-.47-.4-.4-.55-.4h-.48Z" />
            </svg>
            {faqTextos.boton}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Gris más oscuro que --color-muted: 7,6:1 sobre blanco */
  .ayuda-texto {
    color: color-mix(in srgb, var(--color-ink) 25%, var(--color-muted));
  }

  .ayuda-cta {
    border: 1.5px solid var(--color-border);
    transition: background-color 200ms ease, border-color 200ms ease, color 200ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .ayuda-cta:hover {
      border-color: var(--color-blue);
      background-color: var(--color-blue);
      color: var(--color-white);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ayuda-cta {
      transition: none;
    }
  }
</style>
