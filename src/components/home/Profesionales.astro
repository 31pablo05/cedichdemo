---
import { profesionales } from '../../data/profesionales.js';
import { getWhatsappLink } from '../../data/site.js';

// Con más de un profesional, este layout solo muestra el primero.
// Para varios, pasar a una grilla de cards en lugar de este bloque foto+card.
const profesional = profesionales[0];
const whatsappLink = getWhatsappLink('Hola, quiero hacer una consulta médica');
---

<section id="profesionales" class="relative w-full overflow-hidden" style={{ backgroundImage: 'var(--gradient-navy)' }}>
  <!-- Foto del profesional: panel en mobile, fondo completo de la sección desde lg -->
  <div class="relative aspect-[4/5] w-full overflow-hidden lg:absolute lg:inset-0 lg:aspect-auto">
    <picture>
      <source media="(min-width: 1024px)" srcset="/imagenes/herodesktop4.png" />
      <img
        src="/imagenes/andresperfil2.png"
        alt="Dr. Andrés Galarza en la sala de endoscopía de CEDICH"
        width="1672"
        height="941"
        loading="lazy"
        class="absolute inset-0 h-full w-full object-cover object-[50%_14%] lg:object-[50%_18%]"
      />
    </picture>

    <!-- Overlay vertical, para legibilidad del contenido que va debajo en mobile -->
    <div
      class="pointer-events-none absolute inset-0 lg:hidden"
      style={{
        backgroundImage:
          'linear-gradient(to bottom, color-mix(in srgb, var(--color-navy-deep) 10%, transparent) 0%, transparent 38%, color-mix(in srgb, var(--color-navy-deep) 55%, transparent) 78%, color-mix(in srgb, var(--color-navy-deep) 95%, transparent) 100%)',
      }}
    />

    <!-- Overlay horizontal, de izquierda (texto) a derecha (foto bien visible) -->
    <div
      class="pointer-events-none hidden lg:block lg:absolute lg:inset-0"
      style={{
        backgroundImage:
          'linear-gradient(90deg, color-mix(in srgb, var(--color-navy-deep) 95%, transparent) 0%, color-mix(in srgb, var(--color-navy-deep) 88%, transparent) 35%, transparent 55%)',
      }}
    />

    <!-- Velo inferior, muy leve, para asentar la tarjeta del doctor -->
    <div
      class="pointer-events-none hidden lg:block lg:absolute lg:inset-x-0 lg:bottom-0 lg:h-40"
      style={{
        backgroundImage:
          'linear-gradient(to top, color-mix(in srgb, var(--color-navy-deep) 45%, transparent) 0%, transparent 100%)',
      }}
    />
  </div>

  <!-- Contenido: eyebrow, título, bajada y CTA -->
  <div class="container relative z-10 pt-8 pb-6 md:pt-10 lg:flex lg:min-h-[680px] lg:items-center lg:py-20 xl:min-h-[740px]">
    <div class="reveal lg:max-w-[400px] xl:max-w-[440px]">
      <p class="eyebrow eyebrow-light">PROFESIONALES</p>
      <h2 class="mt-4 text-white">Experiencia médica al servicio de tu salud</h2>
      <p class="mt-4 max-w-[40ch] text-[15px] text-white/75">
        Nuestro equipo combina trayectoria, actualización constante y un trato humano en cada
        consulta.
      </p>
      <a
        href={whatsappLink}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-6 inline-flex w-fit items-center justify-center gap-2 rounded-[var(--radius-pill)] bg-white px-6 py-3 font-medium text-[var(--color-ink)] shadow-[0_4px_14px_rgba(0,0,0,0.18)] transition-all duration-200 hover:-translate-y-0.5 hover:shadow-[0_8px_22px_rgba(0,0,0,0.25)]"
      >
        Consultar por WhatsApp
      </a>
    </div>
  </div>

  <!-- Card del profesional: capa informativa, no una segunda tarjeta grande -->
  <div class="profesional-card reveal reveal-delay-2 relative z-10 mx-5 mb-10 rounded-[var(--radius-lg)] border border-white/15 bg-[color-mix(in_srgb,var(--color-navy-panel)_80%,transparent)] p-5 shadow-[var(--shadow-float)] backdrop-blur-md transition-shadow duration-300 md:mx-10 sm:w-[320px] lg:absolute lg:inset-auto lg:bottom-12 lg:right-6 lg:mx-0 lg:mb-0 lg:w-[260px] xl:right-14">
    <h3 class="text-[18px] font-bold text-white">{profesional.nombre}</h3>
    <div class="mt-3 border-t border-white/[0.12]"></div>

    <ul class="mt-3 flex flex-col gap-2.5">
      {
        profesional.atributos.map((atributo) => (
          <li class="flex items-start gap-2.5">
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="var(--color-cyan)"
              stroke-width="1.5"
              class="mt-0.5 shrink-0"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="9" />
              <path d="M8.5 12.5l2.5 2.5 4.5-5" />
            </svg>
            <span class="text-[13px] text-white/85 max-w-none">{atributo}</span>
          </li>
        ))
      }
    </ul>

    {
      profesional.matricula && (
        <p class="mt-3 text-[12px] text-[var(--color-cyan)] max-w-none">
          {profesional.matricula}
        </p>
      )
    }
  </div>
</section>

<style>
  .profesional-card:hover {
    box-shadow: var(--shadow-float), 0 0 0 1px color-mix(in srgb, var(--color-cyan) 40%, transparent),
      0 0 32px color-mix(in srgb, var(--color-cyan) 25%, transparent);
  }

  @media (prefers-reduced-motion: reduce) {
    .profesional-card {
      transition: none;
    }
  }
</style>
