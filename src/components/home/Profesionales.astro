---
import { profesionales } from '../../data/profesionales.js';
import { getWhatsappLink } from '../../data/site.js';
import HexPattern from '../ui/HexPattern.astro';

// Con más de un profesional, este layout solo muestra el primero.
// Para varios, pasar a una grilla de cards en lugar de este bloque de tres zonas.
const profesional = profesionales[0];
const whatsappLink = getWhatsappLink('Hola, quiero hacer una consulta médica');
---

<section
  id="profesionales"
  class="container my-14 md:my-24"
>
  <div
    class="relative rounded-[var(--radius-lg)] overflow-hidden"
    style={{ backgroundImage: 'var(--gradient-navy)' }}
  >
    <HexPattern color="var(--color-cyan)" opacity={0.06} />

    <div class="relative flex flex-col lg:flex-row">
      <!-- Zona izquierda: texto -->
      <div class="lg:w-[34%] p-6 md:p-12 flex flex-col justify-center">
        <p class="eyebrow eyebrow-light">PROFESIONALES</p>
        <h2 class="mt-4 text-white">Experiencia médica al servicio de tu salud</h2>
        <p class="mt-4 text-white/75 text-[15px] max-w-[40ch]">
          Nuestro equipo combina trayectoria, actualización constante y un trato humano en cada
          consulta.
        </p>
        <a
          href={whatsappLink}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-6 inline-flex items-center justify-center gap-2 self-start rounded-[var(--radius-pill)] bg-white text-[var(--color-ink)] px-6 py-3 font-medium"
        >
          Consultar por WhatsApp
        </a>
      </div>

      <!-- Zona central: foto -->
      <div class="relative lg:w-[32%] aspect-[4/3] lg:aspect-auto">
        <!-- Respaldo mientras no exista la foto: PENDIENTE CLIENTE, foto del profesional -->
        <div
          class="absolute inset-0 flex items-center justify-center"
          style={{ backgroundImage: 'var(--gradient-navy)' }}
        >
          <HexPattern color="var(--color-cyan)" opacity={0.06} />
          <img
            src="/logos/logo-cedich.png"
            alt=""
            width="160"
            height="160"
            class="relative w-28 h-28 md:w-40 md:h-40 opacity-10"
          />
        </div>

        <img
          src="/imagenes/dr-galarza.jpg"
          alt={profesional.nombre}
          width="600"
          height="800"
          loading="lazy"
          class="absolute inset-0 w-full h-full object-cover"
        />

        <div
          class="absolute inset-y-0 left-0 w-16"
          style={{ backgroundImage: 'linear-gradient(to right, var(--color-navy), transparent)' }}
        />
        <div
          class="absolute inset-y-0 right-0 w-16"
          style={{ backgroundImage: 'linear-gradient(to left, var(--color-navy), transparent)' }}
        />
      </div>

      <!-- Zona derecha: card de datos -->
      <div class="lg:w-[34%] p-6 md:p-10 flex items-center">
        <div class="w-full bg-[var(--color-navy-panel)] border border-white/10 rounded-[var(--radius)] p-6">
          <h3 class="text-white text-[22px] font-bold">{profesional.nombre}</h3>
          <div class="mt-4 border-t border-white/[0.12]"></div>

          <ul class="mt-4 flex flex-col gap-4">
            {
              profesional.atributos.map((atributo) => (
                <li class="flex items-start gap-3">
                  <svg
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="var(--color-cyan)"
                    stroke-width="1.5"
                    class="shrink-0 mt-0.5"
                    aria-hidden="true"
                  >
                    <circle cx="12" cy="12" r="9" />
                    <path d="M8.5 12.5l2.5 2.5 4.5-5" />
                  </svg>
                  <span class="text-white/85 text-[14px] max-w-none">{atributo}</span>
                </li>
              ))
            }
          </ul>

          {
            profesional.matricula && (
              <p class="mt-4 text-[12px] text-[var(--color-cyan)] max-w-none">
                {profesional.matricula}
              </p>
            )
          }
        </div>
      </div>
    </div>
  </div>
</section>
