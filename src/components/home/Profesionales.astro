---
import { profesionales } from '../../data/profesionales.js';
import { getWhatsappLink } from '../../data/site.js';
import HexPattern from '../ui/HexPattern.astro';

// Con más de un profesional, este layout solo muestra el primero.
// Para varios, pasar a una grilla de cards en lugar de este bloque de tres zonas.
const profesional = profesionales[0];
const whatsappLink = getWhatsappLink('Hola, quiero hacer una consulta médica');
---

<section
  id="profesionales"
  class="container my-14 md:my-24"
>
  <div
    class="relative overflow-hidden rounded-[var(--radius-lg)]"
    style={{ backgroundImage: 'var(--gradient-navy)' }}
  >
    <HexPattern color="var(--color-cyan)" opacity={0.06} />

    <div class="relative flex flex-col lg:min-h-[560px] lg:flex-row">
      <!-- Zona izquierda: texto -->
      <div class="reveal relative z-10 flex flex-col justify-center gap-1 p-6 pb-0 md:p-10 md:pb-0 lg:w-[35%] lg:p-14">
        <p class="eyebrow eyebrow-light">PROFESIONALES</p>
        <h2 class="mt-4 text-white">Experiencia médica al servicio de tu salud</h2>
        <p class="mt-4 max-w-[40ch] text-[15px] text-white/75">
          Nuestro equipo combina trayectoria, actualización constante y un trato humano en cada
          consulta.
        </p>
        <a
          href={whatsappLink}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-6 inline-flex w-fit items-center justify-center gap-2 rounded-[var(--radius-pill)] bg-white px-6 py-3 font-medium text-[var(--color-ink)] shadow-[0_4px_14px_rgba(0,0,0,0.18)] transition-all duration-200 hover:-translate-y-0.5 hover:shadow-[0_8px_22px_rgba(0,0,0,0.25)]"
        >
          Consultar por WhatsApp
        </a>
      </div>

      <!-- Zona derecha: foto grande + card flotante del profesional -->
      <div class="reveal reveal-delay-1 relative mt-6 w-full pb-6 lg:mt-0 lg:w-[65%] lg:pb-0">
        <div class="relative aspect-[4/5] overflow-hidden lg:aspect-auto lg:absolute lg:inset-0">
          <picture>
            <source media="(min-width: 768px)" srcset="/imagenes/andresperfil1.png" />
            <img
              src="/imagenes/andresperfil2.png"
              alt="Dr. Andrés Galarza — Especialista en Endoscopía Digestiva"
              width="720"
              height="1280"
              loading="lazy"
              class="absolute inset-0 h-full w-full object-cover object-[center_18%]"
            />
          </picture>

          <div
            class="hidden lg:block lg:absolute lg:inset-y-0 lg:left-0 lg:w-1/3"
            style={{
              backgroundImage:
                'linear-gradient(to right, var(--color-navy) 0%, color-mix(in srgb, var(--color-navy) 55%, transparent) 20%, transparent 45%)',
            }}
          />
        </div>

        <!-- Card del profesional: superpuesta sobre la foto -->
        <div class="reveal reveal-delay-2 relative z-10 -mt-8 mx-4 rounded-[20px] border border-white/10 bg-[var(--color-navy-panel)] p-6 shadow-[var(--shadow-float)] md:mx-6 lg:absolute lg:inset-auto lg:bottom-8 lg:right-8 lg:mt-0 lg:mx-0 lg:w-[300px] lg:bg-[color-mix(in_srgb,var(--color-navy-panel)_88%,transparent)] lg:backdrop-blur-sm">
          <h3 class="text-[20px] font-bold text-white">{profesional.nombre}</h3>
          <div class="mt-4 border-t border-white/[0.12]"></div>

          <ul class="mt-4 flex flex-col gap-3">
            {
              profesional.atributos.map((atributo) => (
                <li class="flex items-start gap-3">
                  <svg
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="var(--color-cyan)"
                    stroke-width="1.5"
                    class="mt-0.5 shrink-0"
                    aria-hidden="true"
                  >
                    <circle cx="12" cy="12" r="9" />
                    <path d="M8.5 12.5l2.5 2.5 4.5-5" />
                  </svg>
                  <span class="text-[14px] text-white/85 max-w-none">{atributo}</span>
                </li>
              ))
            }
          </ul>

          {
            profesional.matricula && (
              <p class="mt-4 text-[12px] text-[var(--color-cyan)] max-w-none">
                {profesional.matricula}
              </p>
            )
          }
        </div>
      </div>
    </div>
  </div>
</section>
