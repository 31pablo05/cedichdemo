---
const { color = 'var(--color-cyan)', opacity = 0.06 } = Astro.props;
const patternId = `hex-pattern-${crypto.randomUUID()}`;
---

<svg
  class="absolute inset-0 w-full h-full pointer-events-none select-none"
  style={{ opacity }}
  aria-hidden="true"
>
  <defs>
    <pattern id={patternId} width="56" height="98" patternUnits="userSpaceOnUse">
      <polygon
        points="28,0 56,14 56,42 28,56 0,42 0,14"
        fill="none"
        stroke={color}
        stroke-width="1"
      />
      <polygon
        points="28,42 56,56 56,84 28,98 0,84 0,56"
        fill="none"
        stroke={color}
        stroke-width="1"
      />
    </pattern>
  </defs>
  <rect width="100%" height="100%" fill={`url(#${patternId})`} />
</svg>
