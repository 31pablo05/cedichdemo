---
import { nav } from '../../data/nav.js';
import { site, getWhatsappLink } from '../../data/site.js';
import MobileNav from './MobileNav.jsx';
import { logoSrc } from '../../lib/imagenes.js';

const whatsappLink = getWhatsappLink('Hola, quiero hacer una consulta');

// Fuera de la home no hay hero oscuro detrás: el header arranca y se queda en su estado sólido
const esSolido = Astro.url.pathname !== '/';
---

<header
  id="site-header"
  class:list={['fixed top-0 left-0 w-full z-50 h-[76px] lg:h-[82px]', { 'is-scrolled': esSolido }]}
  data-solido={esSolido ? '' : undefined}
>
  <!-- Velo sutil detrás de la barra, para leer sobre la foto del hero sin fondo sólido -->
  <div class="header-glow absolute inset-x-0 top-0 h-24 pointer-events-none"></div>

  <div class="container relative h-full flex items-center justify-between gap-4">
    <a href="/" class="header-brand flex items-center gap-2.5 shrink-0 md:gap-3 lg:gap-3.5">
      <span class="header-logo-container flex items-center justify-center rounded-full bg-white p-[5px] md:p-[6px] lg:p-[8px]">
        <img
          src={logoSrc}
          alt=""
          width="42"
          height="42"
          class="header-logo h-[26px] w-auto md:h-[30px] lg:h-[40px]"
        />
      </span>
      <span class="flex flex-col leading-tight">
        <span class="header-brand-name font-display font-bold text-[16px] text-white md:text-[20px] lg:text-[24px]">CEDICH</span>
        <span class="header-brand-tag hidden text-[10px] leading-tight text-white/70 md:block lg:text-[12px]">
          Centro de Endoscopías Digestivas de Chubut
        </span>
      </span>
    </a>

    <nav class="hidden lg:flex items-center gap-5 xl:gap-8">
      {
        nav.map((item) => (
          <a
            href={item.href}
            data-nav-link
            data-ancla={item.ancla}
            class="nav-link group relative text-white/85 text-[15px] font-medium transition-colors hover:text-white"
          >
            {item.etiqueta}
            <span class="nav-underline absolute left-0 -bottom-1 h-[2px] w-0 bg-[var(--color-cyan)] transition-all duration-200 group-hover:w-full" />
          </a>
        ))
      }
    </nav>

    <a
      href={whatsappLink}
      target="_blank"
      rel="noopener noreferrer"
      class="header-whatsapp hidden lg:inline-flex items-center gap-2 rounded-[var(--radius-pill)] px-[22px] py-[12px] transition-all duration-300"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38a9.9 9.9 0 0 0 4.74 1.21h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.86 9.86 0 0 0 12.04 2Zm0 1.67c2.19 0 4.25.85 5.8 2.4a8.18 8.18 0 0 1 2.41 5.84c0 4.55-3.7 8.24-8.24 8.24a8.3 8.3 0 0 1-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.55 3.7-8.24 8.28-8.24Zm-4.53 4.7c-.16 0-.42.06-.64.3-.22.24-.85.83-.85 2.02 0 1.19.87 2.34 1 2.5.12.16 1.7 2.6 4.13 3.64 2.04.87 2.46.7 2.9.65.44-.04 1.42-.58 1.62-1.14.2-.56.2-1.04.14-1.14-.06-.1-.22-.16-.46-.28-.24-.12-1.42-.7-1.64-.78-.22-.08-.38-.12-.54.12-.16.24-.62.78-.76.94-.14.16-.28.18-.52.06-.24-.12-1.02-.38-1.94-1.2-.72-.64-1.2-1.44-1.34-1.68-.14-.24-.02-.37.1-.5.11-.1.24-.28.36-.42.12-.14.16-.24.24-.4.08-.16.04-.3-.02-.42-.06-.12-.54-1.32-.75-1.8-.2-.47-.4-.4-.55-.4h-.48Z" />
      </svg>
      Consultar por WhatsApp
    </a>

    <div class="flex lg:hidden items-center">
      <MobileNav client:media="(max-width: 1023px)" />
    </div>
  </div>
</header>

<style>
  #site-header {
    transition: height 300ms ease;
  }

  .header-glow {
    background-image: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--color-navy) 55%, transparent) 0%,
      transparent 100%
    );
    transition: opacity 300ms ease;
  }

  .header-logo-container {
    border: 1px solid rgba(255, 255, 255, 0.15);
    box-shadow: var(--shadow-card);
    transition: padding 300ms ease, border-color 300ms ease;
  }

  .header-logo {
    transition: height 300ms ease;
  }

  .nav-link.is-active {
    color: white;
  }

  .nav-link.is-active .nav-underline {
    width: 100%;
  }

  .header-whatsapp {
    background-color: color-mix(in srgb, var(--color-navy-deep) 55%, transparent);
    border: 1.5px solid color-mix(in srgb, var(--color-white) 70%, transparent);
    color: white;
    backdrop-filter: blur(10px);
    animation: header-whatsapp-glow 3s ease-in-out infinite;
  }

  @keyframes header-whatsapp-glow {
    0%,
    100% {
      box-shadow: 0 0 0 0 rgba(75, 169, 232, 0);
    }

    50% {
      box-shadow: 0 0 0 6px rgba(75, 169, 232, 0.12);
    }
  }

  .header-whatsapp:hover {
    background-color: white;
    border-color: white;
    color: var(--color-ink);
    animation: none;
  }

  #site-header.is-scrolled {
    height: 64px;
    background-color: color-mix(in srgb, var(--color-navy-deep) 82%, transparent);
    backdrop-filter: blur(14px) saturate(150%);
    border-bottom: 1px solid color-mix(in srgb, var(--color-cyan) 22%, transparent);
    box-shadow: 0 6px 24px color-mix(in srgb, var(--color-navy-deep) 30%, transparent);
  }

  #site-header.is-scrolled .header-glow {
    opacity: 0;
  }

  /* En desktop el logo mantiene el mismo tamaño con y sin scroll; solo la altura de la barra se compacta */
  @media (min-width: 1024px) {
    #site-header.is-scrolled {
      height: 70px;
      background-color: color-mix(in srgb, var(--color-navy-deep) 94%, transparent);
      border-bottom-color: color-mix(in srgb, var(--color-cyan) 24%, transparent);
    }

    .header-glow {
      height: 120px;
      background-image: linear-gradient(
        to bottom,
        color-mix(in srgb, var(--color-navy-deep) 78%, transparent) 0%,
        color-mix(in srgb, var(--color-navy-deep) 38%, transparent) 55%,
        transparent 100%
      );
    }

    .header-logo-container {
      border-color: color-mix(in srgb, var(--color-cyan-light) 45%, transparent);
    }

    .header-brand-name {
      font-family: var(--font-title);
      font-weight: 700;
      letter-spacing: -0.01em;
      line-height: 1.1;
    }

    .header-brand-tag {
      max-width: 150px;
      margin-top: 3px;
      font-family: var(--font-text);
      font-size: 11.5px;
      line-height: 1.25;
      color: color-mix(in srgb, var(--color-white) 82%, transparent);
    }

    .nav-link {
      font-family: var(--font-text);
      font-size: 15px;
      font-weight: 500;
    }

    .header-whatsapp {
      min-height: 48px;
      padding: 0 18px;
      font-family: var(--font-text);
      font-size: 15px;
      font-weight: 600;
      white-space: nowrap;
    }
  }

  @media (min-width: 1280px) {
    .header-brand-tag {
      max-width: none;
      font-size: 12px;
    }

    .header-whatsapp {
      padding: 0 24px;
    }
  }

  @media (max-width: 1023.98px) {
    #site-header.is-scrolled .header-logo-container {
      padding: 4px;
    }

    #site-header.is-scrolled .header-logo {
      height: 22px;
    }
  }

  #site-header.is-scrolled .header-whatsapp {
    background-color: white;
    border-color: white;
    color: var(--color-ink);
    box-shadow: none;
    animation: none;
  }

  #site-header.is-scrolled .header-whatsapp:hover {
    background-color: var(--color-surface);
    box-shadow: var(--shadow-card-hover);
  }

  @media (prefers-reduced-motion: reduce) {
    .header-whatsapp {
      animation: none;
    }
  }
</style>

<script>
  const header = document.getElementById('site-header');
  const esSolido = header?.hasAttribute('data-solido') ?? false;

  const onScroll = () => {
    if (!header) return;
    if (esSolido || window.scrollY > 40) {
      header.classList.add('is-scrolled');
    } else {
      header.classList.remove('is-scrolled');
    }
  };

  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  // Indicador de sección activa: una sección pasa a ser la activa cuando su borde superior
  // cruza el primer tercio de la pantalla (contando el header fijo).
  const navLinks = Array.from(document.querySelectorAll('[data-nav-link]'));
  const navAnchors = new Set(navLinks.map((link) => link.getAttribute('data-ancla')));

  // Cada bloque de la página hereda el ítem del menú de la sección anterior si no tiene uno propio
  // (Tecnología → Profesionales; preguntas frecuentes y obras sociales → Pacientes; footer → Contacto).
  const zones = [];
  let currentGroup = '';
  document.querySelectorAll('main > *, body > footer').forEach((el) => {
    if (el.id && navAnchors.has(`#${el.id}`)) currentGroup = `#${el.id}`;
    zones.push({ el, group: currentGroup });
  });

  const setActiveGroup = (group) => {
    navLinks.forEach((link) => {
      const isActive = group !== '' && link.getAttribute('data-ancla') === group;
      link.classList.toggle('is-active', isActive);
      if (isActive) {
        link.setAttribute('aria-current', 'location');
      } else {
        link.removeAttribute('aria-current');
      }
    });
  };

  const computeGroup = () => {
    const headerHeight = header ? header.offsetHeight : 0;
    const line = headerHeight + (window.innerHeight - headerHeight) / 3;
    const atBottom = window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2;
    if (atBottom && zones.length) return zones[zones.length - 1].group;

    let group = '';
    for (const zone of zones) {
      if (zone.el.getBoundingClientRect().top <= line) group = zone.group;
      else break;
    }
    return group;
  };

  // Mientras la página scrollea hacia un ítem clickeado, se respeta ese ítem para evitar parpadeos intermedios
  let isNavigating = false;
  let navigatingTimer = 0;
  let ticking = false;

  const holdNavigation = () => {
    isNavigating = true;
    window.clearTimeout(navigatingTimer);
    navigatingTimer = window.setTimeout(() => {
      isNavigating = false;
      setActiveGroup(computeGroup());
    }, 250);
  };

  const onSpyScroll = () => {
    if (isNavigating) {
      holdNavigation();
      return;
    }
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(() => {
      ticking = false;
      setActiveGroup(computeGroup());
    });
  };

  navLinks.forEach((link) => {
    link.addEventListener('click', () => {
      setActiveGroup(link.getAttribute('data-ancla') ?? '');
      holdNavigation();
    });
  });

  setActiveGroup(computeGroup());
  window.addEventListener('scroll', onSpyScroll, { passive: true });
  window.addEventListener('resize', onSpyScroll, { passive: true });
</script>
