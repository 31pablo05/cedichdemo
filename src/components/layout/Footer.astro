---
import { site } from '../../data/site.js';

const anioActual = new Date().getFullYear();
---

<footer class="bg-[var(--color-navy-deep)] py-10">
  <div class="container">
    <div class="flex flex-col lg:flex-row items-center justify-between gap-6 text-center lg:text-left">
      <a href="#main" class="flex items-center gap-3">
        <img
          src="/logos/logo-cedich.png"
          alt="CEDICH"
          width="38"
          height="38"
          class="h-[38px] w-auto"
        />
        <span class="font-display font-bold text-[18px] text-white">CEDICH</span>
      </a>

      <p class="text-[13px] text-white/55 max-w-none">{site.nombreCompleto}</p>

      <p class="text-[13px] text-white/55 max-w-none">
        {anioActual} CEDICH. Todos los derechos reservados.
      </p>
    </div>

    <div class="mt-8 border-t border-white/10"></div>

    <p class="mt-5 text-[12px] text-white/40 text-center lg:text-left max-w-none">
      La información de este sitio es orientativa y no reemplaza la consulta médica.
    </p>
  </div>
</footer>
