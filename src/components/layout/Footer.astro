---
import { site, getWhatsappLink, whatsappMensajes } from '../../data/site.js';
import { nav } from '../../data/nav.js';
import { legal } from '../../data/legal.js';
import { footer } from '../../data/footer.js';
import HexPattern from '../ui/HexPattern.astro';
import { isotipo } from '../../lib/imagenes.js';

const anioActual = new Date().getFullYear();
const whatsappConsulta = getWhatsappLink(whatsappMensajes.consultaGeneral);

/** @type {Record<string, string>} */
const iconosRedes = {
  instagram:
    '<rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="1.5"/><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.5"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/>',
  facebook:
    '<path d="M13.5 21v-7.5h2.5l.5-3h-3V8.5c0-.9.2-1.5 1.5-1.5h1.6V4.3C15.8 4.2 14.7 4 13.6 4c-2.5 0-4.1 1.5-4.1 4.3V10.5H7v3h2.5V21h4Z" fill="currentColor" stroke="none"/>',
  tiktok:
    '<path d="M14.5 2c.3 1.9 1.6 3.3 3.5 3.7v2.6c-1.3 0-2.5-.4-3.5-1.1v5.6c0 3-2.4 5.4-5.4 5.4S3.7 15.8 3.7 12.8c0-2.7 2-4.9 4.6-5.3v2.7c-1.1.3-1.9 1.3-1.9 2.6 0 1.4 1.2 2.6 2.6 2.6s2.6-1.2 2.6-2.6V2h2.9Z" fill="currentColor" stroke="none"/>',
  whatsapp:
    '<path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38a9.9 9.9 0 0 0 4.74 1.21h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.86 9.86 0 0 0 12.04 2Zm0 1.67c2.19 0 4.25.85 5.8 2.4a8.18 8.18 0 0 1 2.41 5.84c0 4.55-3.7 8.24-8.24 8.24a8.3 8.3 0 0 1-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.55 3.7-8.24 8.28-8.24Zm-4.53 4.7c-.16 0-.42.06-.64.3-.22.24-.85.83-.85 2.02 0 1.19.87 2.34 1 2.5.12.16 1.7 2.6 4.13 3.64 2.04.87 2.46.7 2.9.65.44-.04 1.42-.58 1.62-1.14.2-.56.2-1.04.14-1.14-.06-.1-.22-.16-.46-.28-.24-.12-1.42-.7-1.64-.78-.22-.08-.38-.12-.54.12-.16.24-.62.78-.76.94-.14.16-.28.18-.52.06-.24-.12-1.02-.38-1.94-1.2-.72-.64-1.2-1.44-1.34-1.68-.14-.24-.02-.37.1-.5.11-.1.24-.28.36-.42.12-.14.16-.24.24-.4.08-.16.04-.3-.02-.42-.06-.12-.54-1.32-.75-1.8-.2-.47-.4-.4-.55-.4h-.48Z" fill="currentColor" stroke="none"/>',
};

// Links de redes desde site.js (Facebook: PENDIENTE CLIENTE, ver site.js; TikTok se oculta mientras no tenga URL)
const redes = [
  { nombre: 'Instagram', url: site.instagram.url, icono: iconosRedes.instagram },
  { nombre: 'Facebook', url: site.facebook.url, icono: iconosRedes.facebook },
  { nombre: 'TikTok', url: site.tiktok.url, icono: iconosRedes.tiktok },
  { nombre: 'WhatsApp', url: whatsappConsulta, icono: iconosRedes.whatsapp },
].filter((red) => red.url);
---

<footer class="relative overflow-hidden bg-[var(--color-navy-deep)] pb-8 pt-12 md:pt-16 lg:pb-10 lg:pt-[72px]">
  <div class="footer-top-line pointer-events-none absolute inset-x-0 top-0 h-px" aria-hidden="true"></div>
  <HexPattern color="var(--color-cyan)" opacity={0.04} />

  <div class="container relative">
    <!-- Cuerpo en columnas: una en mobile, dos en tablet, cuatro en desktop -->
    <div class="grid grid-cols-1 gap-8 md:grid-cols-2 md:gap-x-8 md:gap-y-12 lg:grid-cols-[1.4fr_1fr_1fr_1fr] lg:gap-8">
      <!-- Columna 1: marca -->
      <div>
        <a href="/" class="inline-flex items-center gap-3">
          <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-white">
            <img src={isotipo.src} alt="" width={isotipo.width} height={isotipo.height} class="h-auto w-[34px]" />
          </span>
          <span class="flex flex-col leading-tight">
            <span class="font-display text-[18px] font-bold text-white">{site.nombreCorto}</span>
            <span class="mt-0.5 text-[12px] text-white/70">{site.nombreCompleto}</span>
          </span>
        </a>

        <p class="mt-4 max-w-[34ch] text-[13px] leading-[1.7] text-white/70">{footer.descripcion}</p>

        <div class="mt-4 flex items-center gap-2.5 md:mt-5">
          {
            redes.map((red) => (
              <a
                href={red.url}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${red.nombre} de CEDICH`}
                class="footer-social relative flex h-11 w-11 items-center justify-center rounded-full border border-white/15 text-white/80"
              >
                <svg class="relative h-[18px] w-[18px]" viewBox="0 0 24 24" aria-hidden="true" set:html={red.icono} />
              </a>
            ))
          }
        </div>
      </div>

      <!-- Columna 2: navegación (oculta en mobile) -->
      <div class="hidden md:block">
        <p class="footer-col-title">{footer.columnas.navegacion}</p>
        <nav aria-label="Navegación del pie" class="mt-4 flex flex-col gap-3">
          {
            nav.filter((item) => item.etiqueta !== 'Inicio').map((item) => (
              <a href={item.href} class="footer-nav-link -my-2 inline-flex w-fit items-center py-2 text-[13px] text-white/70">
                <span class="footer-nav-dash" aria-hidden="true" />
                <span class="footer-nav-label">{item.etiqueta}</span>
              </a>
            ))
          }
        </nav>
      </div>

      <!-- Contacto y horarios: un solo bloque compacto en mobile, dos columnas desde tablet -->
      <div class="flex flex-col gap-3 md:contents">
        <p class="footer-col-title md:hidden">{footer.columnas.contactoYHorarios}</p>

        <div>
          <p class="footer-col-title hidden md:block">{footer.columnas.contacto}</p>
          <address class="flex flex-col gap-3 text-[13px] not-italic text-white/70 md:mt-4">
            <a href={site.googleFichaUrl} target="_blank" rel="noopener noreferrer" class="footer-contact-link flex items-start gap-2.5">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--color-cyan)" stroke-width="1.5" class="mt-0.5 shrink-0" aria-hidden="true">
                <path d="M12 21s7-6.5 7-11.5A7 7 0 0 0 5 9.5C5 14.5 12 21 12 21Z" />
                <circle cx="12" cy="9.5" r="2.5" />
              </svg>
              <span class="leading-[1.6]">
                {site.direccion}, {site.localidad}, {site.provincia}
                <span class="block text-white/60">{site.referencia}</span>
              </span>
            </a>

            <a href={`tel:+${site.whatsapp}`} class="footer-contact-link -my-2 flex items-center gap-2.5 py-2">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--color-cyan)" stroke-width="1.5" class="shrink-0" aria-hidden="true">
                <path d="M6 3h3l2 5-2.5 1.5a11 11 0 0 0 5 5L15 12l5 2v3a2 2 0 0 1-2 2A16 16 0 0 1 4 5a2 2 0 0 1 2-2Z" />
              </svg>
              {site.telefono}
            </a>

            <!-- En mobile WhatsApp ya está en los íconos de redes -->
            <a href={whatsappConsulta} target="_blank" rel="noopener noreferrer" class="footer-contact-link -my-2 hidden items-center gap-2.5 py-2 md:flex">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="shrink-0 text-[var(--color-cyan)]" aria-hidden="true" set:html={iconosRedes.whatsapp} />
              WhatsApp
            </a>

            <a
              href={site.googleComoLlegarUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="footer-link-arrow group mt-1 hidden w-fit items-center gap-1.5 text-[13px] font-semibold text-white md:inline-flex"
            >
              {footer.contacto.comoLlegar}
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="transition-transform group-hover:translate-x-1 motion-reduce:transition-none" aria-hidden="true">
                <path d="M5 12h14" />
                <path d="M13 6l6 6-6 6" />
              </svg>
            </a>
          </address>
        </div>

        <div>
          <p class="footer-col-title hidden md:block">{footer.columnas.horarios}</p>
          <!-- PENDIENTE CLIENTE: horarios a confirmar (ver site.js) -->
          <ul class="flex flex-col gap-1.5 text-[13px] text-white/70 md:mt-4 md:gap-0 md:divide-y md:divide-dashed md:divide-white/10">
            {
              site.horarios.map((horario) => (
                <li class="flex items-center gap-2.5 md:justify-between md:gap-3 md:py-2.5 md:first:pt-0">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--color-cyan)" stroke-width="1.5" class="shrink-0 md:hidden" aria-hidden="true">
                    <circle cx="12" cy="12" r="9" />
                    <path d="M12 7v5l3 3" />
                  </svg>
                  <span class="min-w-[4.75rem] md:min-w-0">{horario.dia}</span>
                  <span>{horario.franja}</span>
                </li>
              ))
            }
          </ul>
          <p class="mt-4 hidden text-[12px] text-white/60 md:block">{footer.horarios.nota}</p>
        </div>
      </div>
    </div>

    <!-- Franja legal -->
    <div class="mt-8 flex flex-col items-center gap-5 border-t border-white/10 pt-6 text-center md:mt-12 lg:mt-14 lg:flex-row lg:items-center lg:justify-between lg:gap-8 lg:text-left">
      <div>
        <p class="max-w-none text-[13px] text-white/75">© {anioActual} {site.nombreCorto}. Todos los derechos reservados.</p>
        <p class="mt-1 max-w-none text-[12px] text-white/60">{footer.avisoMedico}</p>
      </div>

      <div class="flex flex-col items-center gap-4 lg:flex-row lg:gap-6">
        <div class="flex flex-col items-center lg:items-end">
          {
            legal.length > 0 && (
              <nav aria-label="Legales" class="flex flex-wrap items-center justify-center gap-x-2 lg:justify-end">
                {legal.map((item, index) => (
                  <>
                    <a href={item.href} class="footer-legal-link">
                      {item.etiqueta}
                    </a>
                    {index < legal.length - 1 && (
                      <span class="text-white/30" aria-hidden="true">
                        ·
                      </span>
                    )}
                  </>
                ))}
              </nav>
            )
          }
          <a
            href={footer.credito.url}
            target="_blank"
            rel="noopener noreferrer"
            class="footer-credito inline-block py-1 text-[12px] text-white/60"
          >
            {footer.credito.texto}
          </a>
        </div>

        <button
          type="button"
          class="footer-arriba flex h-11 w-11 shrink-0 items-center justify-center rounded-full border border-white/25 text-white/85"
          aria-label={footer.volverArriba}
          title={footer.volverArriba}
          data-volver-arriba
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 19V5" />
            <path d="M6 11l6-6 6 6" />
          </svg>
        </button>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer-top-line {
    background-image: linear-gradient(to right, var(--color-cyan), transparent);
    opacity: 0.4;
  }

  .footer-col-title {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: white;
  }

  .footer-social {
    transition: background-color 200ms ease, border-color 200ms ease, color 200ms ease;
  }

  .footer-social:hover,
  .footer-social:focus-visible {
    background-color: var(--color-cyan);
    border-color: var(--color-cyan);
    color: var(--color-navy-deep);
  }

  .footer-nav-dash {
    display: inline-block;
    width: 0;
    height: 1px;
    margin-right: 0;
    background-color: var(--color-cyan);
    transition: width 200ms ease, margin-right 200ms ease;
  }

  .footer-nav-label {
    transition: color 200ms ease;
  }

  .footer-nav-link:hover .footer-nav-dash,
  .footer-nav-link:focus-visible .footer-nav-dash {
    width: 12px;
    margin-right: 8px;
  }

  .footer-nav-link:hover .footer-nav-label,
  .footer-nav-link:focus-visible .footer-nav-label {
    color: white;
  }

  .footer-contact-link,
  .footer-credito {
    transition: color 200ms ease;
  }

  .footer-contact-link:hover,
  .footer-contact-link:focus-visible {
    color: white;
  }

  .footer-credito:hover,
  .footer-credito:focus-visible {
    color: rgba(255, 255, 255, 0.85);
  }

  .footer-legal-link {
    display: inline-block;
    padding-block: 6px;
    font-size: 13px;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.75);
    transition: color 200ms ease;
  }

  .footer-legal-link:hover,
  .footer-legal-link:focus-visible {
    color: var(--color-cyan);
  }

  .footer-arriba {
    transition: background-color 200ms ease, border-color 200ms ease, color 200ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .footer-arriba:hover {
      background-color: white;
      border-color: white;
      color: var(--color-navy-deep);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .footer-social,
    .footer-nav-dash,
    .footer-nav-label,
    .footer-contact-link,
    .footer-credito,
    .footer-legal-link,
    .footer-arriba {
      transition: none;
    }
  }
</style>

<script>
  // El scroll suave (o instantáneo con movimiento reducido) lo define scroll-behavior en global.css
  document.querySelector('[data-volver-arriba]')?.addEventListener('click', () => {
    window.scrollTo({ top: 0 });
  });
</script>
