---
import { site } from '../data/site.js';

import Header from '../components/layout/Header.astro';
import MobileNav from '../components/layout/MobileNav.jsx';
import Footer from '../components/layout/Footer.astro';
import WhatsappFloat from '../components/ui/WhatsappFloat.astro';

import '../styles/global.css';

const {
  title = 'CEDICH · Endoscopía y colonoscopía en Rawson, Chubut',
  description = 'Centro de Endoscopías Digestivas de Chubut. Endoscopía digestiva alta, colonoscopía y tests de aire espirado en Rawson. Coordiná tu turno por WhatsApp.',
  ogImage = '/og-cedich.jpg',
} = Astro.props;

// URLs canónicas sin barra final, consistentes con navegación interna
const canonicalPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const canonicalUrl = new URL(canonicalPath === '/' ? '/' : canonicalPath, Astro.site ?? Astro.url.origin);
const ogImageUrl = new URL(ogImage, Astro.site ?? Astro.url.origin);
const ogImageAlt = `${site.nombreCompleto} — ${site.nombreCorto}`;

const esHome = Astro.url.pathname === '/';

const baseUrl = (Astro.site ?? Astro.url.origin).toString().replace(/\/$/, '');
const logoUrl = `${baseUrl}/logos/logo-cedich-128.png`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'MedicalOrganization',
  name: site.nombreCompleto,
  description: 'Centro de Endoscopías Digestivas de Chubut. Especialistas en endoscopía digestiva alta, colonoscopía y tests de aire espirado.',
  url: baseUrl,
  logo: logoUrl,
  image: ogImageUrl.toString(),
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.direccion,
    addressLocality: site.localidad,
    addressRegion: site.provincia,
    postalCode: site.codigoPostal,
    addressCountry: site.pais,
  },
  telephone: site.telefonoInternacional,
  sameAs: [site.instagram.url, site.facebook.url].filter(Boolean),
};
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#001A28" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:site_name" content={site.nombreCorto} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@600;700&family=IBM+Plex+Sans:wght@400;500;600;700&family=Montserrat:wght@600;700;800&family=DM+Sans:wght@400;500;600;700&display=swap"
    />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    {
      esHome && (
        <script is:inline>
          // Home: al cargar o recargar sin ancla se muestra desde arriba (sin restaurar el scroll anterior).
          // Con ancla en la URL (link compartido), el navegador va a esa sección.
          if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
          if (!location.hash) window.scrollTo(0, 0);
        </script>
      )
    }
  </head>
  <body class="font-body text-[var(--color-ink)] bg-white">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[100] focus:bg-white focus:text-[var(--color-ink)] focus:px-4 focus:py-2 focus:rounded-[var(--radius-sm)]"
    >
      Saltar al contenido principal
    </a>

    <Header />
    <MobileNav client:media="(max-width: 1023px)" />

    <main id="main">
      <slot />
    </main>

    <Footer />
    <WhatsappFloat />

    <script>
      const reveal = () => {
        const elements = document.querySelectorAll('.reveal');
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.15 }
        );

        elements.forEach((el) => observer.observe(el));
      };

      reveal();

      // Resplandor que sigue el cursor en paneles .spotlight, throttled con rAF
      const spotlightEls = document.querySelectorAll('.spotlight');

      spotlightEls.forEach((el) => {
        if (!(el instanceof HTMLElement)) return;

        let ticking = false;
        let lastX = 0;
        let lastY = 0;

        el.addEventListener('pointermove', (event) => {
          if (!(event instanceof PointerEvent)) return;
          lastX = event.clientX;
          lastY = event.clientY;
          if (!ticking) {
            ticking = true;
            requestAnimationFrame(() => {
              const rect = el.getBoundingClientRect();
              el.style.setProperty('--spot-x', `${lastX - rect.left}px`);
              el.style.setProperty('--spot-y', `${lastY - rect.top}px`);
              ticking = false;
            });
          }
        });
      });
    </script>
  </body>
</html>
